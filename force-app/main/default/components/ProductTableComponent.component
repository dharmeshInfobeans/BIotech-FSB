<apex:component controller="ProductTableController" access="global">
    <apex:attribute name="orderId" type="Id" assignTo="{!parentObjId}" required="true" description="The related order" access="global" />

    <table border="1">
        <tr>
            <th>Product Name</th>
            <th>Model</th>
            <th>Quantity</th>
            <th>FOC QTY</th>
            <th>Total QTY</th>
        </tr>
        <apex:repeat value="{!ProductOrderList}" var="product">
            <tr>
                <td>{!product.Product__r.Name}</td>
                <td>{!product.Model_Txt__c}</td>
                <td>{!product.Quantity__c}</td>
                <td>{!product.FOC_Quantity__c}</td>
                <td>{!product.Total_Quantities__c}</td>
            </tr>
        </apex:repeat>
    </table>
</apex:component>