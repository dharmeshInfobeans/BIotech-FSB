<apex:page showHeader="false" standardStylesheets="false" lightningStylesheets="true" docType="html-5.0" controller="BeatPlanSecondAppPageController">
    <apex:slds />
    
    
    
    <html>
        <head>
            <meta charset="utf-8" />   
            <meta http-equiv="x-ua-compatible" content="ie=edge" />
            <title>DCR</title>
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <!-- Import the Design System style sheet -->
            <script src="//ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
            <script src="https://code.angularjs.org/1.6.9/angular.min.js"></script>
            <apex:slds />
            <script src="//cdnjs.cloudflare.com/ajax/libs/jquery/2.1.4/jquery.min.js" />
            <script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.10.3/moment.min.js"/>
                <script src="{!URLFOR($Resource.aljs,'/jquery.aljs-all-with-moment.min.js')}" />
                    <link href = "https://code.jquery.com/ui/1.12.0/themes/ui-lightness/jquery-ui.css" rel = "stylesheet"/>
                        <script src = "https://code.jquery.com/jquery-1.10.2.js"></script>
            <script src="https://code.jquery.com/ui/1.12.0/jquery-ui.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.7.3/Chart.js" integrity="sha256-rjYnB0Bull7k2XkbJ03UNGqMuMieR769uQVGSSlsi6A=" crossorigin="anonymous"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui-touch-punch/0.2.3/jquery.ui.touch-punch.min.js"></script>
            <script>
                var isExcluded = {!includecustomer};
            console.log('Is Excluded:', isExcluded);
            
            // Use the variable anywhere in the page
            if (isExcluded) {
                //alert('The user\'s country is excluded!');
            }
            </script>
            <style>
                .se-pre-con {
                position: fixed;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                z-index: 9999;
                background: url("{!$Resource.biotech_Logo}" )center no-repeat #fff;
                background-size: 300px 100px;
                }
                .red-border {
                border: 2px solid red !important;
                }
                .required {
                color: red; /* This sets the color of the star */
                font-weight: bold; /* Makes the star bold */
                margin-left: 4px; /* Adds some space between the label and the star */
                }
            </style>
        </head>
        <body ng-app="myApp" ng-controller="myCtrl">                   
            <div class="se-pre-con"></div>
            <div class="slds-scope">
                <header class="header" style="height:8vh;background:whitesmoke">
                    <img src="{!$Resource.biotech_Logo}" style="height:70px;width:50px;padding-bottom:24px;"/>
                    <div style="float:right"><img src="{!$Resource.back_button}" ng-click="home()" style="float:right;height:30px;width:30px;margin:10px;cursor:pointer"/> </div>
                </header> 
                
                <!-- Added below Code BY gyadeen-->
                <div id="Uploaddocument" style="background-color: #ffcc00; color: black; text-align: center; padding: 10px; font-weight: bold; display: none; z-index: 9999; position: fixed; top: 5px; left: 50%; transform: translateX(-50%); width: 60%;">
                    {!customercretaion.Kindly_Initiate_the_customer_code_in_SAP__c}
                    <span onclick="document.getElementById('Uploaddocument').style.display='none';" style="float: right; cursor: pointer; font-weight: bold; margin-right: 10px;">&times;</span>
                </div>
                <div id="commercializewarning" style="background-color: #ffcc00; color: black; text-align: center; padding: 10px; font-weight: bold; display: none; z-index: 9999; position: fixed; top: 5px; left: 50%; transform: translateX(-50%); width: 60%;">
                    {!customercretaion.Kindly_Please_fill_the_SAP_code_before_m__c}
                    <span onclick="document.getElementById('commercializewarning').style.display='none';" style="float: right; cursor: pointer; font-weight: bold; margin-right: 10px;">&times;</span>
                </div>
                <!-- Added Above Code BY gyadeen-->
                
                
                <div ng-show="mainPage" style="padding:5px">
                    <article class="slds-card">
                        <div class="slds-card__header slds-grid">
                            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                                <div class="slds-media__body slds_brand">
                                    <h2 class="slds-card__header-title">
                                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="{!$Label.Accounts}">
                                            <span>{{eventData.Account__r.Name}}</span>
                                        </a>
                                    </h2>
                                </div>
                            </header>
                        </div>
                    </article>
                    
                    
                    <article class="slds-card">
                        <div class="slds-card__header slds-grid">
                            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                                <div class="slds-media__figure">
                                    <span class="slds-icon_container slds-icon-standard-account" title="{!$Label.account}">
                                        <svg class="slds-icon slds-icon_small" aria-hidden="true">
                                            <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/standard-sprite/svg/symbols.svg#customers')}"></use>
                                        </svg>
                                        <span class="slds-assistive-text">{!translationObject.Customer_Details__c}</span>
                                    </span>
                                </div>
                                <div class="slds-media__body">
                                    <h2 class="slds-card__header-title">
                                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="{!$Label.Accounts}">
                                            <span>{!translationObject.Customer_Details__c}</span>
                                        </a>
                                    </h2>
                                </div>
                            </header>
                        </div>
                        <div class="slds-card__body slds-card__body_inner">
                            <dl class="slds-list_horizontal slds-wrap">
                                <dt class="slds-item_label slds-text-color_weak slds-truncate" title="{!$Label.First_Label}">{!translationObject.Customer_Name__c}:</dt>
                                <dd class="slds-item_detail slds-truncate" title="{!$Label.Description_for_first_label}"><span ng-show="{{eventData.Leads__r.Name!= ''}}">{{eventData.Leads__r.Name}}</span ><span ng-show="{{eventData.Account__r.Name!= ''}}">{{eventData.Account__r.Name}}</span> </dd>
                                <dt class="slds-item_label slds-text-color_weak slds-truncate" title="{!$Label.First_Label}">CE-CIS Rating:</dt>
                                <dd class="slds-item_detail slds-truncate" title="{!$Label.Description_for_first_label}"><span ng-show="{{eventData.Leads__r.CE_CIS_Rating__c!= ''}}">{{eventData.Leads__r.CE_CIS_Rating__c}}</span ><span ng-show="{{eventData.CE_Rating__c!= ''}}">{{eventData.CE_Rating__c}}</span></dd>
                                <dt class="slds-item_label slds-text-color_weak slds-truncate" title="{!$Label.Second_Label}">Phakic Rating:</dt>
                                <dd class="slds-item_detail slds-truncate" title="{!$Label.Description_for_second_label}"><span ng-show="{{eventData.Leads__r.Phakic_Rating__c!= ''}}">{{eventData.Leads__r.Phakic_Rating__c}}</span ><span ng-show="{{eventData.CIS_Rating__c!= ''}}">{{eventData.CIS_Rating__c}}</span> </dd>
                            </dl>
                        </div>
                    </article>
                    
                    
                    
                    <div class="slds-section slds-is-open" style="clear:both;">
                        <h3 class="slds-section__title">
                            <button aria-controls="expando-unique-id" aria-expanded="true" class="slds-button slds-section__title-action">
                                <svg class="slds-section__title-action-icon slds-button__icon slds-button__icon_left" aria-hidden="true">
                                    <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#switch')}" />
                                </svg>
                                <span class="slds-truncate" title="{!$Label.Section_Title}">{!translationObject.Last_5_Invoices_Details__c}</span>
                            </button>
                        </h3>
                        <div aria-hidden="false" class="slds-section__content" id="expando-unique-id">
                            <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                <thead>
                                    <tr class="slds-line-height_reset">
                                        <th class="" scope="col">
                                            <div class="slds-truncate" title="{!$Label.Opportunity_Name}">{!translationObject.Name__c}</div>
                                        </th>
                                        <th class="" scope="col">
                                            <div class="slds-truncate" title="{!$Label.Account_Name}">{!translationObject.Product__c}</div>
                                        </th>
                                        <th class="" scope="col">
                                            <div class="slds-truncate" title="{!$Label.Close_Date}">{!translationObject.Quantity__c}</div>
                                        </th>
                                        <th class="" scope="col">
                                            <div class="slds-truncate" title="{!$Label.Close_Date}">{!translationObject.Amount__c}</div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="slds-hint-parent" ng-repeat = 'odr in invoiceList'>
                                        <th data-label="{!$Label.Opportunity_Name}" scope="row">
                                            <div class="slds-truncate" title="Cloudhub"><a href="javascript:void(0);" tabindex="-1">{{odr.Dummy_Product_Code__c}}</a></div>
                                        </th>
                                        <td data-label="{!$Label.Account_Name}">
                                            <div class="slds-truncate" title="Cloudhub">{{odr.Product__r.Name}}</div>
                                        </td>
                                        <td data-label="{!$Label.Close_Date}">
                                            <div class="slds-truncate" title="4/14/2015">{{odr.Quantity__c}}</div>
                                        </td>
                                        <td data-label="{!$Label.Prospecting}">
                                            <div class="slds-truncate" title="{!$Label.Prospecting}">{{odr.Amount__c}}</div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                </div> 
                <br/><br/><br/>
                <!-- DCR PAGE -->
                
                
                <p style="background-color:rgb(243, 242, 242);width: 100%;padding-top:4px;padding-bottom:4px;font-size:14px;padding-left:2%;">
                    
                    DCR Details:
                    
                </p>
                
                <div  class="slds-p-around_xx-small" style="margin-left:2%;">
                    
                    <div class="slds-grid slds-gutter">
                        <div class="slds-col">
                            <label class="slds-form-element__label">{!translationObject.Subject__c}</label><br></br>
                        <span><b>{{eventData.Subject}}</b></span><br></br>
                    
                    <div class="slds-form-element slds-size_3-of-4">
                        <input type="text" style="display:none"/>
                        <label class="slds-form-element__label" for="text-input-id-1">{!translationObject.Follow_up_Date__c}</label>
                        <div class="slds-form-element__control slds-input-has-icon slds-input-has-icon_right">
                            <svg onclick="setIcon();" class="slds-icon slds-input__icon slds-input__icon_right slds-icon-text-default" aria-hidden="true">
                                <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#event')}" />
                            </svg>
                            <input id="clickDate" onclick="setIcon();" class="slds-input selectedDate" type="text" placeholder="{!translationObject.Pick_a_Date__c}" />
                        </div>
                        
                    </div>
                    
                    <div style="padding:10px;" ng-show="eventData.Call_Type__c == 'In Clinic Branding'"
                         class="slds-form-element slds-size_3-of-4 slds-grid slds-gutters">
                        
                        <!-- File input -->
                        <button type="button"
                                class="slds-button slds-button_neutral"
                                ng-if="eventData.Call_Type__c == 'In Clinic Branding'"
                                onclick="openBrandingFilePicker()"  ng-model="brandingFile" ng-required="eventData.Call_Type__c == 'In Clinic Branding'">
                            Upload Branding File
                        </button>
                        <!-- ===== Branding file input (DO NOT put inside ng-if) ===== -->
                        
                        
                        
                        
                        
                    </div>
                    <div>
                        <input type="file"
       id="brandingFileInput"
       style="display:none" />

<span id="brandingFileName"
      class="slds-text-body_small slds-m-left_small"></span>
                    </div>
                </div> 
                <div class="slds-col">
                    <!-- Call type -->
                    <div class="slds-form-element">
                        <label class="slds-form-element__label">{!translationObject.Call_type__c}</label>
                        <div class="slds-form-element__control">
                            <span class="slds-form-element__static"><b>{{eventData.Call_Type__c}}</b></span>
                        </div>
                    </div>
                    
                    <!-- Sub call type -->
                    <div class="slds-form-element slds-m-top_small">
                        <label class="slds-form-element__label">Sub call type</label>
                        <div class="slds-form-element__control">
                            <span class="slds-form-element__static">
                                <b>{{eventData.Sub_Call_Type__c}}</b>
                            </span>
                        </div>
                        
                    </div>
                    <div class="field">
                        <label>{!translationObject.Product__c}</label>
                        <select name="Products" class="ui fluid search dropdown" multiple="multiple" id="multi-select">
                            <option ng-repeat="pro in productList">{{pro.Name}}</option>
                        </select>  
                    </div>  
                </div> 
            </div>
            
            
            
            <div class="slds-form-element">
                <label class="slds-form-element__label" for="textarea-id-01"><b><span style="color:red;">*</span></b>{!translationObject.Remark__c}</label>
                <div class="slds-form-element__control">
                    <textarea id="remark" class="slds-textarea" placeholder="{!translationObject.Remark__c}" required="true"></textarea>
                </div>
                <div class="slds-form-element__help" id="error-message-unique-id" ng-show="errorSubMessage==true" style="color:red;padding-left:5px;height:20px;width:100%">{!translationObject1.This_field_required__c}</div>
                <div class="slds-form-element__help" id="error-message-unique-id" ng-show="NoData==true" style="color:white;padding-left:5px;height:20px;background-color:red;width:100%">No data to save.</div>
            </div><br></br>
        
        
        
        
        
        
        
        <div ng-show="eventData.WhatId.indexOf('001')!=0" rendered="{!NOT(ISNULL(leadDataList))}">
            <table style="width:100%;padding:20px; display:block; overflow-x: auto;">
                <tr style="padding:20px;">
                    <th style="font-weight:bold;" >
                        S.No.
                    </th>
                    <th style="font-weight:bold; min-width: 280px !important;" >
                        Lead name
                    </th>
                    <th style="font-weight:bold; min-width: 150px !important;">
                        Current Stage
                    </th>
                    <th style="font-weight:bold;min-width: 150px !important;">
                        Select Stage
                    </th>
                    <th style="font-weight:bold;min-width: 150px !important;">
                        Product Name
                    </th>
                </tr>
                <apex:variable value="{!1}" var="rowNum"/> <!--//ADDED BY GYADEEN -->
                <apex:repeat value="{!leadDataList}" var="lea">
                    <tr style="padding:20px; text-wrap:balance;">
                        <th style="Width:40px;">
                            {!rowNum} <!--//Modifie BY GYADEEN  {!lea.key}--- -->
                        </th>
                        <th style="Width:40px;">
                            {!lea.Name}
                        </th>
                        <th ng-show="eventData.LeadId.indexOf('001')!=0 && (eventData.Profile_Name__c != 'Marketing User')">
                            {!lea.Lead_Stage__c}
                        </th>
                        <th ng-show="eventData.LeadId.indexOf('001')!=0 && (eventData.Profile_Name__c == 'Marketing User')">
                            {!lea.Marketing_Stage__c}
                        </th>
                        
                        <th>
                            <div ng-show="eventData.LeadId.indexOf('001')!=0 && (eventData.Profile_Name__c != 'Marketing User')" >
                                <apex:outputPanel rendered="{!lea.New_Customer__c}">
                                    <form>
                                        <select name="Stages" id="{!lea.Id}" class='leadData' onchange="handleUpdateStage(this.value, '{!lea.Id}','{!lea.SAP_Code__c}')">
                                            <option value="None">--None--</option>
                                            <option value="Appointments">Appointments</option>
                                            <option value="Presentation">Presentation</option>
                                            <option value="Product Demo">Product Demo</option>
                                            <option value="Evaluations">Evaluations</option>
                                            <option value="Commercialization">Commercialization</option>
                                        </select>
                                        <p id="error-message-{!lea.Id}" style="color: red; display: none;">Please select the Stage</p>
                                        
                                    </form>
                                </apex:outputPanel>
                                
                            </div>
                            <div ng-show="eventData.LeadId.indexOf('001')!=0 && (eventData.Profile_Name__c != 'Marketing User')" >
                                <apex:outputPanel rendered="{!lea.Existing_customer__c}">
                                    <form>
                                        <select name="Stages" id="{!lea.Id}" class='leadData' onchange="handleUpdateStage(this.value, '{!lea.Id}','{!lea.SAP_Code__c}')">
                                            <option value="None">--None--</option>
                                            <option value="Appointments">Appointments</option>
                                            <option value="Presentation">Presentation</option>
                                            <option value="Product Demo">Product Demo</option>
                                            <option value="Evaluations">Evaluations</option>
                                            <option value="Upgrade">Upgrade</option>
                                        </select>
                                        <p id="error-message-{!lea.Id}" style="color: red; display: none;">Please select the Stage</p>
                                        
                                    </form>
                                </apex:outputPanel>
                            </div>
                            <div ng-show="eventData.LeadId.indexOf('001')!=0 && (eventData.Profile_Name__c =='Marketing User')" >
                                <apex:outputPanel >
                                    <form>
                                        <select name="Stages" id="{!lea.Id}" class='leadData' onchange="handleUpdateStage(this.value, '{!lea.Id}','{!lea.SAP_Code__c}')">
                                            <option value="None">--None--</option>
                                            <option value="CME">CME</option>CME                                  
                                            <option value="RTM">RTM</option>
                                            <option value="User Meeting">User Meeting</option>
                                            <option value="High Impact CME">High Impact CME</option>
                                            <option value="KOL/FOL Development">KOL/FOL Development</option>
                                            <option value="Virtual exp. Lab">Virtual exp. Lab</option>
                                            <option value="Wet Labs">Wet Labs</option>
                                            <option value="Testimonial">Testimonial</option>
                                            <option value="CTP">CTP</option>
                                            <option value="Focus">Focus</option>
                                            <option value="Decode">Decode</option>
                                            <option value="Inclinic Branding">Inclinic Branding</option>
                                        </select>
                                        <p id="error-message-{!lea.Id}" style="color: red; display: none;">Please select the Stage</p>
                                        
                                    </form>
                                </apex:outputPanel>
                            </div>
                            
                            
                        </th>
                        <th style="min-width: 300px !important;">
                            {!lea.Product__c}
                        </th>
                    </tr>
                    <apex:variable var="rowNum" value="{!rowNum + 1}"/> <!--//ADDED BY GYADEEN -->
                </apex:repeat>
                
            </table>
        </div>
        
        
        
        
        
        
        
        
        <!-- Start BD Tracker -->
        <br/>
        <div style = "width:100%">
            
            <apex:outputpanel rendered="{!isPdAvailable}">
                <p style="background-color:rgb(243, 242, 242);width: 100%;padding-top:4px;padding-bottom:4px;font-size:14px;">
                    
                    BD Tracker Details:
                    
                </p>
                
                <apex:form id="BDWrap1"> 
                    
                    <apex:inputHidden id="selected" value="{!lstWrapStringValue}"/>
                    <apex:inputHidden id="error" value="{!isError}"/>
                    <!-- <apex:actionFunction name="checkPlansSelection" action="{!checkPlans}" reRender="BDWrap1"/> -->
                    
                    <apex:repeat value="{!lstWrapper}" var="item" id="lstWrap">
                        <article class="slds-card" style = "width:100%;margin-top:5px;" id="art">
                            <div class="slds-card__body slds-card__body_inner">
                                
                                <div id="div1">
                                    <div class="slds-form-element" id="div2">
                                        <label class="slds-checkbox_toggle slds-grid">
                                            
                                            
                                            <input type="checkbox" name="checkbox-toggle-17" class='BDCheckBox' value="{!item.isCheck}" aria-describedby="checkbox-toggle-17" 
                                                   id="{!item.objEvent.Id}" onchange="checkVal('{!item.objEvent.Id}')"/> 
                                            <span id="checkbox-toggle-17" class="slds-checkbox_faux_container" aria-live="assertive">
                                                <span class="slds-checkbox_faux"></span>
                                                <span class="slds-checkbox_on"></span>
                                                <span class="slds-checkbox_off"></span>
                                            </span> 
                                            
                                        </label>
                                    </div>
                                </div>
                                
                                
                                <div class="slds-hide" id="{!item.objEvent.Id +'_evError'}"  style="color:red">{!$Label.Please_Select_Product_Discussion_First}</div>
                                <div class="slds-hide" id="{!item.objEvent.Id +'_cmError'}"  style="color:red">{!$Label.Please_Select_Product_Discussion_First}</div>
                                <br/>
                                {!$Label.Product} : {!item.objEvent.Product__c}<br/>
                                {!$Label.Contact} : {!item.conName} <br/>
                                {!$Label.Stage}   : {!item.objEvent.BD_Tracker_Phase__c} <br/>
                                {!$Label.Week}    : {!item.objEvent.Milestone_Plan_Week__c} <br/>
                                
                                
                                <p>{!$Label.Remark} </p>
                                <textarea id="{!item.objEvent.Id +'_Remark'}" class="slds-textarea" value="{!item.remark}" style="width:100%"  placeholder="{!$Label.Enter_Remark_Here}"></textarea>
                                
                                
                                <div  class = "Div1 slds-hide" id="{!item.objEvent.Id +'_Error'}" style="color:red;">{!translationObject1.This_field_required__c}</div> 
                                
                                
                                <apex:outputpanel rendered="{!IF(item.objEvent.Milestone_Stage__c=='Delay',True,false)}">
                                    
                                    <p>{!$Label.Delay_Reason} </p>
                                    <textarea id="{!item.objEvent.Id +'_DelayReamrk'}" class="slds-textarea" value="{!item.objEvent.milestone_delay_reason__c}" 
                                              style="width:100%; display:{!IF(item.objEvent.MileStone_Stage__c=='{!$Label.Delay}','{!$Label.block}','{!$Label.none}')}"
                                              required="{!IF(item.objEvent.MileStone_Stage__c=='Delay',true,false)}"  placeholder="{!$Label.Enter_Milestone_Delay_Reason_Here}"></textarea>
                                    
                                    <div class="slds-hide" id="{!item.objEvent.Id +'_Delay'}"  style="color:red">{!translationObject1.This_field_required__c}</div>
                                </apex:outputpanel>  
                                
                                <apex:outputpanel rendered="{!IF(OR(OR(OR(item.objEvent.BD_Tracker_Phase__c=='Commercialization',item.objEvent.BD_Tracker_Phase__c=='Ticarileştirme'),item.objEvent.BD_Tracker_Phase__c=='Comercialização'),item.objEvent.BD_Tracker_Phase__c=='Comercialización'),True,false)}">
                                    
                                    <p>{!$Label.BD_Plan_Status} <abbr class="slds-required" title="required">* </abbr></p> 
                                    <select  id="{!item.objEvent.Id +'_Stage'}" style="width:50%" value="{!item.objEvent.BD_Plan_Status__c}">
                                        
                                        <option value="Won">{!$Label.Won}</option>
                                        <option value="Closed Lost">{!$Label.Closed_Lost}</option>  
                                        
                                    </select>
                                    <div id="{!item.objEvent.Id +'_LostStage'}">
                                        <p>{!$Label.Reason} <abbr class="slds-required" title="required">* </abbr></p>
                                        <select value="{!item.objEvent.Reason__c }" id="{!item.objEvent.Id +'_LostStageId'}" style="width:50%">
                                            
                                            <option value="Other">{!$Label.Reason}</option>
                                        </select>
