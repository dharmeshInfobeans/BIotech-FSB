<script>
var brandingFile = {
    fileName: null,
    base64: null
};

function openBrandingFilePicker() {
    var input = document.getElementById('brandingFileInput');
    if (!input) {
        console.log('❌ brandingFileInput not found');
        return;
    }
    input.value = ''; // allow reselect same file
    input.click();
}

document.addEventListener('DOMContentLoaded', function () {
    var input = document.getElementById('brandingFileInput');
    if (!input) return;

    input.addEventListener('change', function (e) {
        if (!e.target.files || !e.target.files.length) return;

        var file = e.target.files[0];
        brandingFile.fileName = file.name;

        document.getElementById('brandingFileName').innerText = file.name;

        var reader = new FileReader();
        reader.onload = function (evt) {
            brandingFile.base64 = evt.target.result.split(',')[1];
            console.log('✅ File selected:', brandingFile.fileName);
        };
        reader.readAsDataURL(file);
    });
});
</script>

