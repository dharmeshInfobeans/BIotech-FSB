    function hideErrorMessages(elementIds) {
        elementIds.forEach(id => {
            const element = document.getElementById(id);
            if (element) {
            element.style.display = 'none';
        }
                           });
    }
    
    function displayErrorMessages(elementIds, message) {
        elementIds.forEach(id => {
            const errorElement = document.getElementById(id);
            if (errorElement) {
            // Set and display the error message
            errorElement.innerHTML = message;
            errorElement.style.display = 'block';
            errorElement.style.opacity = '1';
            
            // Automatically hide the error after a delay with fade-out effect
            setTimeout(() => {
            errorElement.style.transition = 'opacity 2s ease'; // Transition duration
            errorElement.style.opacity = '0'; // Start fade-out
            
            setTimeout(() => {
            errorElement.style.display = 'none';
        }, 2000); // Match this with transition duration (2s)
    }, 7000); // Delay before fade-out (7 seconds)
}
               });
}


