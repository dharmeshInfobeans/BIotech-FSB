<apex:page applyHtmlTag="false"
           showHeader="false"
           renderAs="pdf"
           standardController="Master_Agreement__c"
           extensions="AgreementVFExtension"
           >
    <html>
        <head>
            <style>
                @page {
                size: A4;
                margin-top: 4cm;
                margin-bottom: 2cm;
                margin-left: 1.5cm;
                margin-right: 1.5cm;
                
                @top-center {
                content: element(header);
                }
                @bottom-left {
                content: element(footer);
                }
                }
                
                div.header {
                position: running(header);
                text-align: center;
                font-weight: bold;
                font-size: 14px;
                height: 100px;
                }
                
                div.footer {
                display: block;
                position: running(footer);
                font-size: 10px;
                }
                
                .pagenumber:before {
                content: counter(page);
                }
                
                .pagecount:before {
                content: counter(pages);
                }
                
                .header-table {
                width: 100%;
                border-bottom: 2px solid black;
                }
                
                .header-table td {
                padding: 5px;
                font-size: 12px;
                font-weight: bold;
                }
                
                .logo-container {
                width: 120px;
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                }
                
                .logo {
                max-width: 100%;
                max-height: 100%;
                }
                
                .content {
                margin-top: 150px;
                font-family: "Times New Roman", Times, serif;
                font-size: 14px;
                text-align: justify;
                line-height: 1.5;
                }
                
                .section-title {
                font-weight: bold;
                font-size: 14px;
                margin-top: 10px;
                }
                
                .section-content {
                margin-left: 15px;
                }
                
                .bold {
                font-weight: bold;
                }
                
                .lowercase {
                text-transform: lowercase;
                }
                
                .rich-text-content {
                font-family: "Times New Roman", Times, serif !important;
                font-size: 14px !important;
                line-height: 1.5;
                text-align: justify;
                }
                
                /* Scoped styling within .nested-list-container */
                .nested-list-container {
                counter-reset: main-counter;
                }
                
                .nested-list-container ol {
                counter-reset: sub-counter;
                margin-left: 20px; /* Consistent indentation for all levels */
                padding-left: 0;
                }
                
                .nested-list-container ol > li {
                counter-increment: main-counter;
                list-style-type: none;
                margin-top: 12px; /* Adjusted to match spacing between divs */
                line-height: 1.5;
                }
                
                .nested-list-container ol > li::before {
                content: counter(main-counter) ". ";
                font-weight: bold;
                }
                
                /* Level 2 */
                .nested-list-container ol ol {
                counter-reset: sub-counter;
                }
                
                .nested-list-container ol ol > li {
                counter-increment: sub-counter;
                list-style-type: none;
                }
                
                .nested-list-container ol ol > li::before {
                content: counter(main-counter) "." counter(sub-counter) ". ";
                font-weight: bold;
                }
                
                /* Level 3 */
                .nested-list-container ol ol ol {
                counter-reset: sub-sub-counter;
                }
                
                .nested-list-container ol ol ol > li {
                counter-increment: sub-sub-counter;
                list-style-type: none;
                }
                
                .nested-list-container ol ol ol > li::before {
                content: counter(main-counter) "." counter(sub-counter) "." counter(sub-sub-counter) ". ";
                font-weight: bold;
                }
                
                /* Level 4 */
                .nested-list-container ol ol ol ol {
                counter-reset: sub-sub-sub-counter;
                }
                
                .nested-list-container ol ol ol ol > li {
                counter-increment: sub-sub-sub-counter;
                list-style-type: none;
                }
                
                .nested-list-container ol ol ol ol > li::before {
                content: counter(main-counter) "." counter(sub-counter) "." counter(sub-sub-counter) "." counter(sub-sub-sub-counter) ". ";
                font-weight: bold;
                }
                
                /* Level 5 */
                .nested-list-container ol ol ol ol ol {
                counter-reset: sub-sub-sub-sub-counter;
                }
                
                .nested-list-container ol ol ol ol ol > li {
                counter-increment: sub-sub-sub-sub-counter;
                list-style-type: none;
                }
                
                .nested-list-container ol ol ol ol ol > li::before {
                content: counter(main-counter) "." counter(sub-counter) "." counter(sub-sub-counter) "." counter(sub-sub-sub-counter) "." counter(sub-sub-sub-sub-counter) ". ";
                font-weight: bold;
                }
                
                .no-break {
                page-break-inside: avoid;
                display: inline-block;
                width: 100%;
                } 
                ql-indent-1 { margin-left: 20px; }
                .ql-indent-2 { margin-left: 40px; }
                .ql-indent-3 { margin-left: 60px; }
                .ql-indent-4 { margin-left: 80px; }
            </style>
        </head>
        <body>
            
            <apex:outputPanel rendered="{!IsmessagePresent}" layout="none">
                <apex:pageMessages />
                <h2 style="color: red; text-align: center;">{!message}</h2>
            </apex:outputPanel>
            
            <apex:outputPanel rendered="{!NOT(IsmessagePresent)}" layout="none">
                <!-- Your

<!-- HEADER -->
                <div class="header">
                    <table class="header-table">
                        <!-- First Row: Title -->
                        <tr>
                            <td colspan="2" style="text-align: center; font-size: 16px;">DISTRIBUTION AGREEMENT</td>
                        </tr>
                        <!-- Second Row: Logo -->
                        <tr>
                            <td rowspan="3" style="width: 20%;" class="logo-container">
                                <apex:image url="{!URLFOR($Resource.biotech_Logo)}" 
                                            styleClass="logo"
                                            width="96px"
                                            height="48px"
                                            alt="Biotech Logo"/>
                            </td>
                            <td style="text-align: right;">
                                <strong>Document No.:</strong> {!Master_Agreement__c.Document_No__c}
                            </td>
                        </tr>
                        <!-- Third Row: Version Number -->
                        <tr>
                            <td style="text-align: right;">
                                <strong>Agreement No.:</strong> {!Master_Agreement__c.Agreement_Number__c}
                            </td>
                            
                        </tr>
                        <!-- Fourth Row: Document No. -->
                        <tr>
                            <td style="text-align: right;">
                                <strong>Version No.:</strong> {!Master_Agreement__c.Version__c}
                            </td>
                        </tr>
                    </table>
                </div>
                
                <!-- FOOTER -->
                <div class="footer">
                    
                      <div style="color: White; font-size: 8px; text-align: left;">\i2\</div>
                    <hr />
                    <div>Page <span class="pagenumber"/> of <span class="pagecount"/></div>
                </div>
                <!-- MAIN CONTENT -->
                <div class="content">
                    <div class="rich-text-content">                       
                        <p>
                            This <b>Distribution Agreement</b> is entered into on 
                            <b>{!Master_Agreement__c.Agreement_StartDate_mmmm_format__c}</b> 
                            and effective from <b>{!Master_Agreement__c.Agreement_StartDate_mmmm_format__c}</b>.
                        </p>
                        
                        <p><b>BETWEEN:</b></p>
                        <p>
                            <b>{!Master_Agreement__c.Agreement_Signed_With__c}</b>, a Company incorporated under the Swiss Companies Act 
                            having its Registered Office at 
                            <b>{!SignedWithBranchAddress}</b> 
                            hereinafter, for the sake of brevity, referred to as <b>“Biotech”</b>
                            <!--<b>“{!Master_Agreement__c.Agreement_Signed_With__c}”</b>, -->
                            which expression, unless repugnant to the context, shall include its successors in title and permitted assigns, 
                            of the <b>ONE PART</b>.
                        </p>
                        
                        <p><b>AND</b></p>
                        <p>
                            <b>{!Master_Agreement__c.Account__r.Name}</b> 
                            having its Registered Office at 
                            <span class="lowercase">
                                {!Master_Agreement__c.Account__r.BillingStreet}, 
                                {!Master_Agreement__c.Account__r.BillingCity}, 
                                {!Master_Agreement__c.Account__r.BillingState}, 
                                {!Master_Agreement__c.Account__r.BillingCountry}
                            </span> 
                            hereinafter, for the sake of brevity, referred to as <b>“the Distributor”</b>, 
                            which expression, unless repugnant to the context, shall include its successors in title, 
                            of the <b>OTHER PART</b>.
                        </p>
                        <div style="{!IF(NOT(Master_Agreement__c.Show_Notifying_Party_Details__c), 'display:none;', '')}">
                            
                            
                            
                            <p><b>AND</b></p>
                            <p>
                                <b>{!Master_Agreement__c.Notifying_Party_Company_Name__c}</b> 
                                having its Registered Office at 
                                <span class="lowercase">
                                    {!Master_Agreement__c.Notifying_Party_Address__c}, 
                                    
                                </span> 
                                hereinafter, for the sake of brevity, referred to as <b>“the Notifying Party”</b> 
                            </p>
                        </div>
                        <p>
                            Hereinafter collectively referred to as <b>"Parties"</b> and individually as <b>"Party"</b>.
                            
                        </p>
                        
                        <p>
                            This Agreement includes required content and defines responsibilities between a 
                            manufacturer and a distributor of medical devices in compliance with 
                            <b>Medical Device Regulation, MDR (EU) 2017/745</b> and <b>ISO 13485:2016</b>.
                        </p>
                    </div>
                    
                    
                    <!-- RICH CONTENT -->        
                    <div name="clause">  
                        
                        <div class="rich-text-content" >
                            <apex:outputText escape="false" value="{!Recitals}"/>
                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 0;page-break-before: always;">
                            <apex:outputText escape="false" value="{!Definations}"/>
                        </div>
                        
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 1;">
                            <apex:outputText escape="false" value="{!APPOINTMENTOFDISTRIBUTOR}"/>
                        </div>  
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 2;">
                            <apex:outputText escape="false" value="{!MARKETING}"/>
                        </div>  
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 3;page-break-before: always;">
                            <apex:outputText escape="false" value="{!ANNUALMINIMUMSHIPMENTS}"/>
                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 4;">
