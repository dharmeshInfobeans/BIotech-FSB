                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 5;">
                            <apex:outputText escape="false" value="{!PAYMENTPROCEDURESTESTINGOFPRODUCTS}"/>
                        </div>
                        
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 7;page-break-before: always;">
                            <apex:outputText escape="false" value="{!Cluses8}"/>
                        </div>
                        
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 8;">
                            <apex:outputText escape="false" value="{!WARRANTIESANDINDEMNIFICATIONS}"/>
                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 9;">
                            <apex:outputText escape="false" value="{!PRODUCTRECEIPTTRACEABILITYANDSTORAG}"/>
                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 10;">
                            <apex:outputText escape="false" value="{!FORCEMAJEURECOMPLIANCEWITHLAWS}"/>
                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 12;">
                            <apex:outputText escape="false" value="{!TERMSANDTERMINATION}"/>
                        </div>
                        
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 13;">
                            <apex:outputText escape="false" value="{!BRAND}"/> 
                            <div >
                                <!--style="margin-left: 1.5cm;"-->
                                <apex:outputPanel rendered="{!brandNames.size>0}">
                                    
                                    <apex:pageBlock >
                                        <table style="width: 100%; border-collapse: collapse; font-family: 'Times New Roman', Times, serif; font-size: 14px;">
                                            <thead>
                                                <tr style="page-break-inside: avoid;">
                                                    <th style="width: 10%; border: 1px solid #000; padding: 8px; background-color: #f2f2f2; text-align: center;">Sr. No.</th>
                                                    <th style="width: 20%; border: 1px solid #000; padding: 8px; background-color: #f2f2f2; text-align: left;">Brand</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <apex:variable var="rowIndex" value="{!0}"/>
                                                <apex:repeat value="{!brandNames}" var="brand">
                                                    <apex:variable var="rowIndex" value="{!rowIndex + 1}"/>
                                                    <tr style="page-break-inside: avoid;">
                                                        <td style="border: 1px solid #000; padding: 8px; text-align: center; font-weight: bold;">{!rowIndex}</td>
                                                        <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!brand}</td>
                                                    </tr>
                                                </apex:repeat>
                                            </tbody>
                                        </table>
                                    </apex:pageBlock>
                                </apex:outputPanel>
                            </div>
                        </div>
                        
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 14;">
                            <apex:outputText escape="false" value="{!CONFIDENTIALITYPUBLICITYDISPUTERE}"/>
                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 16;">
                            <apex:outputText escape="false" value="{!MISCELLANEOUS}"/>
                        </div>
                        
                        <div name="Manufacturing details"  >
                            <apex:outputPanel rendered="{!agreementProducts.size>0}">
                                
                                <apex:pageBlock >
                                    <table style="width: 100%; border-collapse: collapse; font-family: 'Times New Roman', Times, serif !important; font-size: 14px;">
                                        <thead>
                                            <tr style="page-break-inside: avoid;">
                                                <th style="width: 10%; border: 1px solid #000; padding: 8px; background-color: #f2f2f2; text-align: center;">Sr. No.</th>
                                                <th style="width: 20%; border: 1px solid #000; padding: 8px; background-color: #f2f2f2; text-align: left;">Product Name</th>
                                                <th style="width: 60%; border: 1px solid #000; padding: 8px; background-color: #f2f2f2; text-align: left;">Manufacturing Site</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <apex:variable var="rowIndex" value="{!0}"/>
                                            <apex:repeat value="{!agreementProducts}" var="ap">
                                                <apex:variable var="rowIndex" value="{!rowIndex + 1}"/>
                                                <tr style="page-break-inside: avoid;">
                                                    <td style="border: 1px solid #000; padding: 8px; text-align: center; font-weight: bold;">{!rowIndex}</td>
                                                    <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!ap.Product__r.Name}</td>
                                                    <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!ap.Product__r.Plant__r.Manufacturing_Site__c}</td>
                                                </tr>
                                            </apex:repeat>
                                        </tbody>
                                    </table>
                                </apex:pageBlock>
                            </apex:outputPanel>
                            
                            
                        </div>
                        <div class="rich-text-content nested-list-container" style="counter-reset: main-counter 17;">
                            <apex:outputText escape="false" value="{!REMARK1}"/>
                        </div>
                    </div>
                    
                    <!-- Attendee CONTENT -->
                    
                    <apex:outputPanel layout="block" style="width: 100%; margin: 20px auto;"> 
                        <!-- Single Table for Biotech & Distributor Information -->
                        <div style="margin-bottom: 20px;" class="no-break">
                            <apex:pageBlock title="">
                                <table style="width: 100%; border-collapse: collapse; table-layout: auto;">
                                    <tr>
                                        <th style="padding: 5px; text-align: left; width: 10%; border-bottom: 1px solid black;">Details</th>
                                        <th style="padding: 5px; text-align: left; width: 40%; border-bottom: 1px solid black;">
                                            {!Master_Agreement__c.Agreement_Signed_With__c}
                                        </th>
                                        <th style="padding: 10px; text-align: left; width: 50%; border-bottom: 1px solid black;border-left: 1px solid black;">
                                            {!Master_Agreement__c.Account__r.Name}
                                        </th>
                                    </tr>
                                    <tr>
                                        <th style="padding: 5px;">Attention</th>
                                        <td style="padding: 5px; word-wrap: break-word; white-space: normal;">Mr. Mehul Asnani</td>
                                        <td style="padding: 5px; word-wrap: break-word; white-space: normal;border-left: 1px solid black;">
                                            {!Master_Agreement__c.Distributer_Contact_Name__c}
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 5px;">Address</th>
                                        <td style="padding: 5px;">{!SignedWithBranchAddress}</td>
                                        <td style="padding: 5px;border-left: 1px solid black;">{!Master_Agreement__c.Distributer_Address__c}</td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 5px;">Email Id</th>
                                        <td style="padding: 5px;">mehulasnani@biotechhealthcare.com</td>
                                        <td style="padding: 5px;border-left: 1px solid black;">
                                            <a href="mailto:{!Master_Agreement__c.Distributer_Email__c}">
                                                {!Master_Agreement__c.Distributer_Email__c}
                                            </a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 5px;">Ph. No.</th>
                                        <td style="padding: 5px;"></td>
                                        <td style="padding: 5px;border-left: 1px solid black;">{!Master_Agreement__c.Distributer_phone_no__c}</td>
                                    </tr>
                                </table>
                            </apex:pageBlock>
                        </div>
                        
                        <!-- Agreement Statement -->
                        <div style="margin-top: 20px;" class="no-break">
                            <apex:pageBlock title="">
                                <p style="padding: 10px;">IN WITNESS WHEREOF, the Parties have caused this Agreement to be executed by their duly authorized representatives as of the day and year first above written.</p>
                            </apex:pageBlock>
                        </div>
                        
                        <!-- Signature Section -->
                        <div style="margin-top: 20px;" class="no-break"> <!-- Applied no-break only to the signature section -->
                            <apex:pageBlock >
                                <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                                    <tr>
                                        <th style="padding: 8px; width: 33%; text-align: left;">For {!Master_Agreement__c.Agreement_Signed_With__c}</th>
                                        <th style="padding: 8px; width: 33%; text-align: left;">For {!Master_Agreement__c.Account__r.Name}</th>
                                        <th style="padding: 8px; width: 34%; text-align: left; 
                                                   {!IF(NOT(Master_Agreement__c.Show_Notifying_Party_Details__c), 'display:none;', '')}">
                                            For {!Master_Agreement__c.Notifying_Party_Company_Name__c}
                                        </th>
                                    </tr>
                                    
                                    <tr>
                                        <td style="padding: 8px; height: 80px; color: #fff;">\s3\</td>
                                        <td style="padding: 8px; height: 80px; color: #fff;">\s1\</td>
                                        <td style="padding: 8px; height: 80px; color: #fff; 
                                                   {!IF(NOT(Master_Agreement__c.Show_Notifying_Party_Details__c), 'display:none;', '')}">
                                             \s3\
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px;"><b>Mr. Mehul Asnani</b></td>
                                        <td style="padding: 8px;"><b>{!Master_Agreement__c.Distributer_Contact_Name__c}</b></td>
                                        <td style="padding: 8px; 
                                                   {!IF(NOT(Master_Agreement__c.Show_Notifying_Party_Details__c), 'display:none;', '')}">
                                            <b>{!Master_Agreement__c.Notifying_Party_Name__c}</b>
                                        </td>
                                    </tr>
                                    
                                    <tr>
                                        <td style="padding: 8px;">Founder &amp; President</td>
                                        <td style="padding: 8px;">{!Master_Agreement__c.Distributer_Contact_Designation__c}</td>
                                        <td style="padding: 8px; 
                                                   {!IF(NOT(Master_Agreement__c.Show_Notifying_Party_Details__c), 'display:none;', '')}">
                                            {!Master_Agreement__c.Notifying_Party_Designation__c}
                                        </td>
                                    </tr>
                                    
                                    <tr>
                                        <td style="padding: 8px; height: 50px;"></td>
                                        <td style="padding: 8px; height: 50px;"></td>
                                        <td style="padding: 8px; height: 50px; 
                                                   {!IF(NOT(Master_Agreement__c.Show_Notifying_Party_Details__c), 'display:none;', '')}">
                                            
                                        </td>
                                    </tr>
                                    
                                    <tr>
                                        <th style="padding: 10px; text-align: left;">
                                            <div style="border-top: 1px solid black; width: 100px; margin-bottom: 5px;"></div>Witness
                                        </th>
                                        <th style="padding: 10px; text-align: left;">
                                            <div style="border-top: 1px solid black; width: 100px; margin-bottom: 5px;"></div>Witness
                                        </th>
                                        <th style="padding: 10px; text-align: left; 
                                                   {!IF(NOT(Master_Agreement__c.Show_Notifying_Party_Details__c), 'display:none;', '')}">
                                            <div style="border-top: 1px solid black; width: 100px; margin-bottom: 5px;"></div>Witness
                                        </th>
                                    </tr>
                                </table>
                            </apex:pageBlock>
                        </div>
                        
                    </apex:outputPanel>
                    
                    
                    <!-- ANNEXURE “A”-->
                    <div style="page-break-before: always;">
                        <h3 style="text-align: center; margin-bottom: 15px;">ANNEXURE “A”</h3>
                        <h3 style="text-align: center; font-weight: bold; margin-bottom: 10px;">PRODUCTS</h3>
                        <apex:outputPanel rendered="{!agreementProducts.size>0}">
                            
                            <apex:pageBlock >
                                <table style="width: 100%; border-collapse: collapse; font-family: 'Times New Roman', Times, serif !important; font-size: 14px;">
                                    <thead>
                                        <tr style="page-break-inside: avoid; background-color: #99ccff; color: black;">
                                            <th style="width: 20%; border: 1px solid #000; padding: 8px; text-align: left;">Generic Name.</th>
                                            <th style="width: 30%; border: 1px solid #000; padding: 8px; text-align: left;">Model Number</th>
                                            <th style="width: 15%; border: 1px solid #000; padding: 8px; text-align: left;">Category</th>
                                            <th style="width: 35%; border: 1px solid #000; padding: 8px; text-align: left;">Port of Loading</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <apex:variable var="rowIndex" value="{!0}"/>
                                        <apex:repeat value="{!agreementProducts}" var="ap">
                                            <apex:variable var="rowIndex" value="{!rowIndex + 1}"/>
                                            <tr style="page-break-inside: avoid;">
                                                <td style="border: 1px solid #000; padding: 8px; text-align: left; font-weight: bold;">{!ap.Product__r.Generic_Name__c}</td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!productVSModelNames[ap.Product__r.Name]}</td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!ap.Product__r.Category__c}</td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!ap.Product__r.plant__r.Port_of_Loading__c}</td>
                                            </tr>
                                        </apex:repeat>
                                    </tbody>
                                </table>
                            </apex:pageBlock>
                        </apex:outputPanel>
                        <div class="rich-text-content " >
                            <apex:outputText escape="false" value="{!ANNEXUREA}"/>
                        </div>
                    </div>
                    
                    <!-- ANNEXURE “B”-->
                    <div style="page-break-before: always;">
                        <h3 style="text-align: center; margin-bottom: 15px;">ANNEXURE “B”</h3>
                        <h3 style="text-align: center; font-weight: bold; margin-bottom: 10px;">TERRITORY</h3>
                        
                        <div class="rich-text-content " >
                            <apex:outputText escape="false" value="{!ANNEXUREB}"/>
                        </div>
                    </div>
                    
                    <!-- ANNEXURE “C”-->
                    <div style="page-break-before: always;">
                        <h3 style="text-align: center; margin-bottom: 15px;">ANNEXURE “C”</h3>
                        <div class="rich-text-content " >
                            <apex:outputText escape="false" value="{!ANNEXUREC}"/>
                        </div>
                        
                    </div>
                    
                    <!-- ANNEXURE “D-->
                    <div style="page-break-before: always;">
                        <h3 style="text-align: center; margin-bottom: 15px;">ANNEXURE “D”</h3>
                        <h3 style="text-align: center; font-weight: bold; margin-bottom: 10px;">PRICE LIST FOR THE PRODUCTS</h3>
                        <apex:outputPanel rendered="{!agreementProducts.size>0}">
                            
                            <apex:pageBlock >
                                <table style="width: 100%; border-collapse: collapse; font-family: 'Times New Roman', Times, serif !important; font-size: 14px;">
                                    <thead>
                                        <tr style="page-break-inside: avoid; background-color: #99ccff; color: black;">
                                            <th style="width: 25%; border: 1px solid #000; padding: 8px; text-align: left;">Product</th>
                                            <th style="width: 10%; border: 1px solid #000; padding: 8px; text-align: center;">Price ({!Master_Agreement__c.CurrencyIsoCode})</th>
                                            <th style="width: 32%; border: 1px solid #000; padding: 8px; text-align: center;">FOC(%)</th>
                                            <th style="width: 8%; border: 1px solid #000; padding: 8px; text-align: left;">Incoterm</th>
                                            <th style="width: 25%; border: 1px solid #000; padding: 8px; text-align: left;">Payment Term</th>
                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <apex:variable var="rowIndex" value="{!0}"/>
                                        <apex:repeat value="{!agreementProducts}" var="ap">
                                            <apex:variable var="rowIndex" value="{!rowIndex + 1}"/>
                                            <tr style="page-break-inside: avoid;">
                                                <td style="border: 1px solid #000; padding: 8px; text-align: left; font-weight: bold;">{!ap.Product__r.Name}</td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">{!ap.Price__c}</td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">{!ap.FOC_Text__c}</td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!ap.Incoterms__c}</td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!paymentTermApiNameVsLabel[ap.Payment_Terms_options__c]}</td>
                                                
                                            </tr>
                                        </apex:repeat>
                                    </tbody>
                                </table>
                            </apex:pageBlock>
                        </apex:outputPanel>
                        
                        
                    </div>
                    
                    <!-- ANNEXURE “E”-->
                    <div style="page-break-before: always;">
                        <h3 style="text-align: center; margin-bottom: 15px;">ANNEXURE “E”</h3>
                        <h3 style="text-align: center; font-weight: bold; margin-bottom: 10px;">BUSINESS PLAN</h3>
                        <apex:outputPanel rendered="{!IsTergetPresent}">
                            
                            <apex:pageBlock >
                                <table style="width: 100%; border-collapse: collapse; font-family: 'Times New Roman', Times, serif !important; font-size: 14px;">
                                    
                                    <!-- Header Row 1: Product & Years -->
                                    <tr style="page-break-inside: avoid; background-color: #99ccff; color: black;">
                                        <th style="border: 1px solid #000; padding: 8px; text-align: left;" rowspan="2">Product Name</th>
                                        <th style="border: 1px solid #000; padding: 8px; text-align: left;" rowspan="2">Product Price ({!Master_Agreement__c.CurrencyIsoCode})</th>
                                        <apex:repeat value="{!allYears}" var="year">
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center;" colspan="2">{!year}</th>
                                        </apex:repeat>
                                    </tr>
                                    <!-- Header Row 2: Target Quantity & Target Value -->
                                    <tr style="page-break-inside: avoid; background-color: #99ccff; color: black;">
                                        <apex:repeat value="{!allYears}" var="year">
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center;">Target Qty</th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center;">Target Value</th>
                                        </apex:repeat>
                                    </tr>
                                    <!-- Data Rows -->
                                    <apex:repeat value="{!productNames}" var="product">
                                        <tr style="page-break-inside: avoid;">
                                            <td style="border: 1px solid #000; padding: 8px; text-align: left; font-weight: bold;">{!product}</td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">{!productPrice[product]}</td>
                                            
                                            <apex:repeat value="{!allYears}" var="year">
                                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">{!productData[product][year][0]}</td> 
                                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">{!productData[product][year][1]}</td>
                                            </apex:repeat>
                                        </tr>
                                    </apex:repeat>
                                    <!-- Total Row -->
                                    <tr style="background-color: #f3f3f3; font-weight: bold;">
                                        <td colspan="2" style="padding: 8px; page-break-inside: avoid;border: 1px solid #000; background-color: #99ccff; color: black;">Total</td>
                                        <apex:repeat value="{!allYears}" var="year">
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">{!totalQuantityByYear[year]}</td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">{!totalValueByYear[year]}</td>
                                        </apex:repeat>
                                    </tr>
                                </table>
                            </apex:pageBlock>
                        </apex:outputPanel>
                    </div>
                    
                </div>
            </apex:outputPanel>
        </body>
    </html>
</apex:page>