                border-color: #80bdff;
                outline: none;
                }
                
                .button-section {
                <!--  display: flex;-->
                justify-content: space-between;
                }
                
                .approve-button, .reject-button {
                font-size: small;
                height: 28px;
                width: 80px;
                color: white;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                transition: background-color 0.3s ease;
                }
                
                .approve-button {
                background: #26c326;
                
                }
                
                .reject-button {
                background: #eb3434;
                }
                
                
                
                .error-message {
                color: red;
                font-size: 12px;
                display: none;
                margin-top: 10px;
                }
                .slds-scope{
                width: 100%;
                margin-left:20px;
                }
                
                
                .logo {
               width: 300px;
                }
                
                .mainForm{
                width: 100%;max-width: 100%;
               
    justify-content: end;
                }
                
                
                
                
                @media (max-width: 600px) {
                .pageBlockTitle {
                font-size: 20px;
                }
                }
                
                 @media (max-width: 1100px) {
                .pageBlockTitle {
                font-size: 20px;
                }
                .mainForm{
                width: 733px;
            justify-content: center;
                }
                }
                
            </style>
            
            
            <script>
            
                window.onload = function() {
                    console.log('Page has been loaded for the first time.');
                    
                    // Example: Call an Apex controller method via JavaScript remoting
                    ApprovalController.logPageVisit(function(result, event) {
                        if (event.status) {
                            console.log('Page visit logged successfully:', result);
                        } else {
                            console.error('Error logging page visit:', event.message);
                        }
                    });
                };
            
            function validateInput() {
                var zsmComment = document.getElementById("ZSMComments").value;
                var errorMessage = document.getElementById("errorMessage");
                
                // Regular expression to match only alphabetical characters (no numbers or special characters) with at least 8 characters
                const regex = /^(?=.*[A-Za-z0-9]).*$/;
                
                if (!regex.test(zsmComment.trim())) {
                    errorMessage.style.display = 'block'; // Show error if invalid
                    return false;
                } else {
                    errorMessage.style.display = 'none'; // Hide error if valid
                    return true;
                }
    }
        
            function handleSubmit(action) {
                
                if (!validateInput()) {
                    return;
                }
                 var approveBtn = document.getElementById("Approve");
                if (action === 'Approve') {
                    approveBtn.disabled = true;
                    approveBtn.style.backgroundColor = 'gray';
                }
                 var rejectBtn = document.getElementById("Reject");
                if (action === 'Reject') {
                    rejectBtn.disabled = true;
                    rejectBtn.style.backgroundColor = 'gray';
                }
                
                var roleData = document.getElementById("ZSMKey").value;
                var zsmComment = document.getElementById("ZSMComments").value;
                var recordId = document.getElementById("recordId").value;
                
                
                console.log('RoleData', roleData);
                console.log('Action', action);
                
                ApprovalController.ZSMkycapproval(action, zsmComment, recordId, roleData, function(result, event) {
                    if (event.status) {
                        //  alert('Thank you for '+ action);
                        console.log(result);
                        if (result.status == 'error') {
                            alert(result.message);
                            approveBtn.disabled = false;
                             rejectBtn.disabled = false;
                            rejectBtn.style.backgroundColor = 'red'
                            approveBtn.style.backgroundColor = '#4CAF50';
                        }else if(result.status == 'success') {
                            window.location.href = "{!thanksurl}";
                        }else {
                            alert('An error occurred: ' + event.message);
                            approveBtn.disabled = false;
                            rejectBtn.disabled = false;
                            rejectBtn.style.backgroundColor = 'red'
                            approveBtn.style.backgroundColor = '#4CAF50';
                        }
                    } else {
                        alert('An error occurred: ' + event.message);
                        approveBtn.disabled = false;
                        rejectBtn.disabled = false;
                        rejectBtn.style.backgroundColor = 'red'
                        approveBtn.style.backgroundColor = '#4CAF50';
                    }
                    
                });
                
                
            }
            </script>
        </head>
