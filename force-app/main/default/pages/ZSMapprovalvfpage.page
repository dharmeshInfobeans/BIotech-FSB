            <style>
                
                
                .TdBody{
                
                max-width: 347px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                vertical-align: top;
                }
                body {
                margin: 10px;
                font-family: Arial, sans-serif;
                height: 100vh;
                display: flex;
                justify-content: center;
                
                }
                
                .pageBlockContainer {
                width: 98%;
                
                
                background-color: rgba(216, 240, 241, 0.9);
                border-radius: 10px;
                /* box-shadow: inset 4px 1px 13px 2px rgba(0, 0, 0, 0.1); */
                padding: 20px;
                text-align: center;
                }
                
                .pageBlockTitle {
