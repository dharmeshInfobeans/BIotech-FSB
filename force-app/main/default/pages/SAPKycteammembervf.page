            <script>
        function validateInput() {
        var JSMSAPcode = document.getElementById("SAPcode").value;
       var errorMessage = document.getElementById('error-message');        
        // Regular expression to match only alphabetical characters (no numbers or special characters) with at least 8 characters
        
        // Validate SAP code length and format (only 10-digit numbers allowed)
        if (JSMSAPcode.length !== 7 || !/^\d{7}$/.test(JSMSAPcode)) {
            errorMessage.innerText = "Please enter a valid SAP code (exactly 7 digits).";
            errorMessage.style.display = 'block'; // Show the error message
            return; // Stop submission if validation fails
        } else {
            errorMessage.style.display = 'none'; // Hide error if valid
        }

    }
    function handleSubmit(action) {
        var roleData = document.getElementById("JSMKey").value;
        var JSMSAPcode = document.getElementById("SAPcode").value;
        var recordId = document.getElementById("recordId").value;
        var errorMessage = document.getElementById('error-message');

        console.log('RoleData', roleData);
        console.log('Action', action);

        // Validate SAP code length and format (only 10-digit numbers allowed)
        if (JSMSAPcode.length !== 7 || !/^\d{7}$/.test(JSMSAPcode)) {
            errorMessage.innerText = "Please enter a valid SAP code (exactly 7 digits).";
            errorMessage.style.display = 'block'; // Show the error message
            return; // Stop submission if validation fails
        } else {
            errorMessage.style.display = 'none'; // Hide error if valid
        }

        // Call the Apex controller method if validation passes
        ApprovalController.JSMSAPcodemethod(action, JSMSAPcode, recordId, roleData, function(result, event) {
            if (event.status) {
                console.log(result);
                if (result.status === 'error') {
                    alert(result.message); // Display error message from server
                } else if (result.status === 'success') {
                    window.location.href = "{!thanksurl}";
                } else {
                    alert('An unknown error occurred.');
                }
            } else {
                alert('An error occurred during submission: ' + event.message);
            }
        });
    }
</script>

