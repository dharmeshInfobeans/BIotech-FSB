<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SPPowerMax_should_Less_than_SPPowerMax1</fullName>
    <active>true</active>
    <errorConditionFormula>IF(( Spherical_Power_Maximum__c &gt; Spherical_Power_Maximum1__c), true, false)</errorConditionFormula>
    <errorDisplayField>Spherical_Power_Maximum__c</errorDisplayField>
    <errorMessage>&quot;Spherical Power Maximum&quot; should be lesser than &quot;Spherical Power Maximum1&quot;.</errorMessage>
</ValidationRule>
