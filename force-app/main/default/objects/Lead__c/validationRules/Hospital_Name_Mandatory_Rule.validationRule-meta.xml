<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hospital_Name_Mandatory_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISPICKVAL(PRIORVALUE(Lead_Stage__c), &quot;Unqualified&quot;),!ISPICKVAL(PRIORVALUE(Lead_Stage__c), &quot;Lost&quot;),ISPICKVAL(Lead_Stage__c, &quot;Won&quot;), ISBLANK( Company__c ))</errorConditionFormula>
    <errorMessage>Please fill the Hospital/clinic name</errorMessage>
</ValidationRule>
