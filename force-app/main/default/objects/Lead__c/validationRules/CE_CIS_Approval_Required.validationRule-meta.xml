<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CE_CIS_Approval_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Lead_Stage__c, &quot;Converted&quot;),
    NOT(Is_Ortho__c),
    NOT(CE_CIS_Approval__c)
)</errorConditionFormula>
    <errorMessage>Lead Status cannot be changed to Converted unless CE-CIS Approval is checked.</errorMessage>
</ValidationRule>
