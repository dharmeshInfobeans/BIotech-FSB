<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Upgrade_Validation_Rule</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
 Existing_customer__c ,
ISPICKVAL(Lead_Stage__c, &quot;Won&quot;),
NOT( ISPICKVAL(PRIORVALUE(Lead_Stage__c),&quot;Upgrade&quot;)

)
)</errorConditionFormula>
    <errorMessage>Please Mark the Stage as Upgrade</errorMessage>
</ValidationRule>
