<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Upgrade_validation_ZIP</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Lead_Stage__c, &quot;Upgrade&quot;),
ISBLANK( Billing_code__c )
)</errorConditionFormula>
    <errorMessage>Please fill the Zip/Postal Code</errorMessage>
</ValidationRule>
