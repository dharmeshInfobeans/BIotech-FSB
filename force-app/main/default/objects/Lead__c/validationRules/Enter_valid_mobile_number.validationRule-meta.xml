<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enter_valid_mobile_number</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  DATEVALUE(CreatedDate) &gt;= DATE(2025, 5, 7),
  NOT(REGEX(Mobile__c, &quot;^[0-9+()]+$&quot;))
)</errorConditionFormula>
    <errorMessage>Please fill the valid mobile number</errorMessage>
</ValidationRule>
