<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_number_validation</fullName>
    <active>false</active>
    <errorConditionFormula>NOT( OR( ISBLANK( Mobile__c ), REGEX(Mobile__c, &quot;[0-9]{16}&quot;) ))</errorConditionFormula>
    <errorMessage>Please enter a valid Phone number</errorMessage>
</ValidationRule>
