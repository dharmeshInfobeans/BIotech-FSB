<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_SAP_code_Validation_rule</fullName>
    <active>false</active>
    <errorConditionFormula>AND(!ISPICKVAL(PRIORVALUE(Lead_Stage__c), &quot;Unqualified&quot;),!ISPICKVAL(PRIORVALUE(Lead_Stage__c), &quot;Lost&quot;), ISPICKVAL(Lead_Stage__c, &quot;Won&quot;), ISBLANK(SAP_Code__c)  )</errorConditionFormula>
    <errorMessage>Please fill the SAP code before Lead convert</errorMessage>
</ValidationRule>
