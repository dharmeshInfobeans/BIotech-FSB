<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OrderPlant_Not_Change</fullName>
    <active>true</active>
    <errorConditionFormula>AND( NOT(Order_Product_Count__c == 0) ,ISCHANGED( plant__c ) )</errorConditionFormula>
    <errorMessage>This order already contains from a different plant.</errorMessage>
</ValidationRule>
