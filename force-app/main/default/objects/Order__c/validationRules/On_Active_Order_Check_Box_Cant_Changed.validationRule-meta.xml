<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>On_Active_Order_Check_Box_Cant_Changed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Status__c , &apos;Active&apos;),
(PRIORVALUE(Is_it_ok_to_cancel_old_Draft_Orders__c) != Is_it_ok_to_cancel_old_Draft_Orders__c) )</errorConditionFormula>
    <errorDisplayField>Is_it_ok_to_cancel_old_Draft_Orders__c</errorDisplayField>
    <errorMessage>On Active Order check box can not be changed.</errorMessage>
</ValidationRule>
