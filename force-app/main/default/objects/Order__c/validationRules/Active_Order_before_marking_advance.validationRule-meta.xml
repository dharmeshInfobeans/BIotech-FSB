<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Order_before_marking_advance</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Advance_Received__c , NOT(ISPICKVAL(Status__c, &apos;Active&apos;)))</errorConditionFormula>
    <errorMessage>Approve the order to mark it as Advance Received</errorMessage>
</ValidationRule>
