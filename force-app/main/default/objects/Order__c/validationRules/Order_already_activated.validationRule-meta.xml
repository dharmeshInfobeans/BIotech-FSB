<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_already_activated</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,&apos;Active&apos;), Is_Activate__c)</errorConditionFormula>
    <errorMessage>Order is already activated.</errorMessage>
</ValidationRule>
