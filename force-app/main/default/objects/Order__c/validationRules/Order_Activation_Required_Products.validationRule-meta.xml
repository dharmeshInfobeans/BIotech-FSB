<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_Activation_Required_Products</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Order_Product_Count__c  &lt;= 0,  ISPICKVAL(Status__c, &apos;Active&apos;))</errorConditionFormula>
    <errorMessage>Order activation requires product selection.</errorMessage>
</ValidationRule>
