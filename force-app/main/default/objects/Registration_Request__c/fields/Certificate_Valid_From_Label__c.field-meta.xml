<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Certificate_Valid_From_Label__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Certificate_Valid_From__c), &quot;&quot;,
  CASE(MONTH(Certificate_Valid_From__c),
    1,&quot;January&quot;, 2,&quot;February&quot;, 3,&quot;March&quot;, 4,&quot;April&quot;,
    5,&quot;May&quot;, 6,&quot;June&quot;, 7,&quot;July&quot;, 8,&quot;August&quot;,
    9,&quot;September&quot;, 10,&quot;October&quot;, 11,&quot;November&quot;, 12,&quot;December&quot;,
  &quot;&quot;) &amp; &quot; &quot; &amp; TEXT(YEAR(Certificate_Valid_From__c))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Certificate Valid From (Label)</label>
    <required>false</required>
