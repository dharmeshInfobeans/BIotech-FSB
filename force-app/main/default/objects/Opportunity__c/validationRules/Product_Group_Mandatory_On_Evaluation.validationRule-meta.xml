<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_Group_Mandatory_On_Evaluation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Evaluation&quot;),
    ISBLANK(Product_Group__c)
)</errorConditionFormula>
    <errorMessage>Please fill in Product Group before moving to Evaluation stage.</errorMessage>
</ValidationRule>
