<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dropped_Reason_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISPICKVAL( Status__c , &apos;Dropped&apos;) , ISBLANK(  Dropped_Reason__c  ) )</errorConditionFormula>
    <errorDisplayField>Dropped_Reason__c</errorDisplayField>
    <errorMessage>Please enter the dropped reason.</errorMessage>
</ValidationRule>
