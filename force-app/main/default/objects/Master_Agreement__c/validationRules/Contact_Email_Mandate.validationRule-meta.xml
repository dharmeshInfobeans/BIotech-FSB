<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Email_Mandate</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT(ISNEW()),
ISBLANK( Contact_Email__c)
)</errorConditionFormula>
    <errorMessage>Contact Email must be populated before saving the record.</errorMessage>
</ValidationRule>
