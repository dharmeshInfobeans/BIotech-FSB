<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AgreementNoValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(  
    OR(  
        ISCLONE(),  
        NOT(ISNEW())  
    ),  
    ISCHANGED(Agreement_Number__c)  
)</errorConditionFormula>
    <errorDisplayField>Agreement_Number__c</errorDisplayField>
    <errorMessage>Agreement Number cannot be changed during cloning or updates.</errorMessage>
</ValidationRule>
