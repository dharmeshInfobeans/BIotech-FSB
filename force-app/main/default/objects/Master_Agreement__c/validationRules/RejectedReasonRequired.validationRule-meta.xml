<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RejectedReasonRequired</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISPICKVAL( Status__c , &apos;Rejected&apos;) , ISBLANK( Rejected_Reason__c ) )</errorConditionFormula>
    <errorDisplayField>Rejected_Reason__c</errorDisplayField>
    <errorMessage>Please enter the reason of rejection.</errorMessage>
</ValidationRule>
