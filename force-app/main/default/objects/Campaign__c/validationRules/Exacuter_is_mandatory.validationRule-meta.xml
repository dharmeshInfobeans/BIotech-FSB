<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exacuter_is_mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISBLANK(Executer__c),
    DATEVALUE(CreatedDate) &gt; DATE(2025, 1, 27)
)</errorConditionFormula>
    <errorDisplayField>Executer__c</errorDisplayField>
    <errorMessage>Please fill the Executer</errorMessage>
</ValidationRule>
