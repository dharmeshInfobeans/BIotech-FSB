<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Visible_To_Current_User__c</fullName>
    <formula>AND(
    TEXT(Region__c) = TEXT($User.Region__c),
    TEXT(Country__c) = TEXT($User.Country__c)
)</formula>
