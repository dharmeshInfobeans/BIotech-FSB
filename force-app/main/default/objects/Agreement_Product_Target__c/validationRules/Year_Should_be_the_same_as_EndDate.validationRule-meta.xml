<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Year_Should_be_the_same_as_EndDate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Start_Date__c)),
  TEXT(YEAR(Start_Date__c)) != TEXT(Year__c)
)</errorConditionFormula>
    <errorDisplayField>Year__c</errorDisplayField>
    <errorMessage>Please select appropreate year based on StartDate of target record.</errorMessage>
</ValidationRule>
