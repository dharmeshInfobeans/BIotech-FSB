<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>when_create_case_user_not_select_status</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISNEW(),
NOT(ISPICKVAL(Case_Status__c, &apos;New&apos;))

)</errorConditionFormula>
    <errorMessage>Select Only New as Case Status</errorMessage>
</ValidationRule>
