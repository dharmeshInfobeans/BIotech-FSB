<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_1_and_Product_2_is_not_empty</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL( Parameter__c ,&apos;Product-Combination&apos;) &amp;&amp;  (ISBLANK(Product_1__c) || ISBLANK(Product_2__c))</errorConditionFormula>
    <errorMessage>Please fill Product 1 and Product 2</errorMessage>
</ValidationRule>
