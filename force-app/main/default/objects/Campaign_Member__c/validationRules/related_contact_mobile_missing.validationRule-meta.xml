<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>related_contact_mobile_missing</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISBLANK(Contact__r.MobilePhone),
NOT(ISBLANK(Account__c))
)</errorConditionFormula>
    <errorMessage>Mobile Number &amp; Email Id of contact is blank. Please update to add campaign members.</errorMessage>
</ValidationRule>
