<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fill_the_Member_type</fullName>
    <active>false</active>
    <errorConditionFormula>AND(DATEVALUE(CreatedDate)&gt;= DATE(2024,7,29) ,
ISPICKVAL(Member_Type__c, &quot;&quot;),
NOT(ISPICKVAL(Campaign1__r.Activity_Type__c, &apos;TRADE BOOTH&apos;)),
NOT(ISPICKVAL(Campaign1__r.Activity_Type__c, &apos;WETLAB&apos;))
)</errorConditionFormula>
