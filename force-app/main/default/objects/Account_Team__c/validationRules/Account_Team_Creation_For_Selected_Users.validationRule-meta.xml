<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Team_Creation_For_Selected_Users</fullName>
    <active>true</active>
    <description>Allow Account Team Creation only for following users:
1. Approver 1
2. Approver 2
3. Domestic Admin
4. System Admin
5. Admin Turkey
6. Turkey Sales</description>
    <errorConditionFormula>ISNEW() &amp;&amp;  ( NOT(OR(Account__r.Approver_1__c ==  $User.Id,
		                   Account__r.Approver_2__c ==  $User.Id,
																	    $Profile.Name == &apos;Admin_Dom&apos;,
																	    $Profile.Name == &apos;System Administrator&apos;,
																					$Profile.Name == &apos;Admin_Tur&apos;,
																					$Profile.Name == &apos;Turkey Sales&apos;
			                 )
			              )
													)</errorConditionFormula>
    <errorMessage>Oops!!, You cannot create account team record</errorMessage>
</ValidationRule>
