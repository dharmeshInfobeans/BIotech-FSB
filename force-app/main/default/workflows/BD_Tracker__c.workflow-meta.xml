            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Status_of_Account_and_CE/Customer_Evaluation_Approved</template>
    </alerts>
    <fieldUpdates>
        <fullName>Month</fullName>
        <field>Month__c</field>
        <formula>Text(Month(Today()))</formula>
        <name>Month</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>RSM_Update</fullName>
        <description>To update RSM Email</description>
        <field>RSM_Email__c</field>
        <formula>Rsm_Email_Update__c</formula>
        <name>RSM Update</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Manager</fullName>
        <description>To Update Manager Email on Record Creation</description>
        <field>Manager_Email__c</field>
        <formula>OwnerManager__c</formula>
        <name>Update Manager</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>notify</fullName>
        <field>Manager_Email__c</field>
        <name>notify</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Month Change</fullName>
        <actions>
            <name>Month</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>BD_Tracker__c.isSubmitted__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Rsm And Manager Email</fullName>
        <actions>
            <name>RSM_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Manager</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>To update manager email for current user</description>
        <formula>ISNEW()</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
