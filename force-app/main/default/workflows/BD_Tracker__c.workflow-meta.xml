        </recipients>
        <recipients>
            <field>RSM_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/BD_Tracker_Record_Deletion</template>
    </alerts>
    <alerts>
