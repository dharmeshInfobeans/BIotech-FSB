<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Calculate_Amount</fullName>
        <field>Amount__c</field>
        <formula>Product__r.MSP__c *  Quantity__c</formula>
        <name>Calculate Amount</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Calculate Amount For Sample Product</fullName>
        <actions>
            <name>Calculate_Amount</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>This workflow will calculate amount for sample product if  quantity and msp field(product)values are not null.</description>
        <formula>AND(NOT(ISNULL(Quantity__c)),NOT(ISNULL(Product__r.MSP__c)),NOT(ISNULL(Product__c)))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
