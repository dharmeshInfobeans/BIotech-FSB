<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>CE_Approved</fullName>
        <description>CE Approved</description>
        <protected>false</protected>
        <recipients>
            <type>accountOwner</type>
        </recipients>
        <recipients>
            <type>creator</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/CE_Approved</template>
    </alerts>
    <alerts>
        <fullName>CE_approval_notification</fullName>
        <description>CE approval  notification</description>
        <protected>false</protected>
        <recipients>
            <field>Approver_1__c</field>
            <type>userLookup</type>
        </recipients>
        <senderAddress>crmhelpdesk@biotechhealthcare.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>unfiled$public/CE_for_Tur</template>
    </alerts>
    <fieldUpdates>
        <fullName>CE_Approved</fullName>
        <field>Status__c</field>
        <literalValue>Approved</literalValue>
        <name>CE Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>CE_Pending_Approval</fullName>
        <field>Status__c</field>
        <literalValue>Pending Approval</literalValue>
        <name>CE Pending Approval</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>CE_Rejected</fullName>
        <field>Status__c</field>
        <literalValue>Rejected</literalValue>
        <name>CE Rejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Increase_Number_Of_Time_Submitted</fullName>
        <field>Number_of_Time_Submitted__c</field>
        <formula>IF( ISNULL(Number_of_Time_Submitted__c) , 1, Number_of_Time_Submitted__c + 1)</formula>
        <name>Increase Number Of Time Submitted</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_CE_Rating_On_Account</fullName>
        <field>CE_Rating__c</field>
        <formula>Customer_Evaluation_Rating__c</formula>
        <name>Set CE Rating On Account</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Account__c</targetObject>
    </fieldUpdates>
    <rules>
        <fullName>update Account CE Rating Field</fullName>
        <actions>
            <name>Set_CE_Rating_On_Account</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>this will update the CE Rating field on Account(Recordtype--&gt;Doctor_D) with the rating field of CE Record</description>
        <formula>AND(OR(RecordType.DeveloperName == &apos;Doctor_D_and_T&apos;,RecordType.DeveloperName==&apos;International_Ortho&apos;,RecordType.DeveloperName==&apos;International_Ophthalmic_Vision&apos;,RecordType.DeveloperName==&apos;International_Dermal&apos;), 				NOT( ISNULL(Customer_Evaluation_Rating__c)), 				NOT( ISNULL(Account__c))					 			)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
