<aura:component controller="CustomerEvaluationController" implements="force:lightningQuickActionWithoutHeader,force:hasRecordId"  access="global">
    
    <aura:attribute type="object" name="formData"></aura:attribute>
    <aura:attribute type="object" default="{}" name="recordObject"></aura:attribute>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="isDisabled" type="boolean" default="false"></aura:attribute>
    <aura:attribute name="isError" type="Boolean" default="false" />
    <aura:attribute name="errorMessage" type="String" default="" />
    
    <aura:if isTrue="{!$Browser.isPhone}">
        <aura:html tag="style">
            .slds-modal__content{
            height: 100%;
            }
            .slds-modal__container {
            justify-content: space-between;
            }
            .mobileScroller{
            height:102%;
            }
        </aura:html>
        <aura:set attribute="else">
            <aura:html tag="style">
                .modal-container{
                width: 70%;
                max-width: 70%;
                }
                .modal{
                margin-bottom:50px;
                }
                .modalContainer{
                margin-top:45px !important;
                }
            </aura:html>
        </aura:set>
    </aura:if>
    <lightning:spinner aura:id="CESpinner" variant="brand" size="medium" class="slds-hide"/>
    <section style="outline: none !important;" role="dialog" tabindex="-1"  aria-modal="true" aria-describedby="modal-content-id-1" class="modal slds-modal slds-fade-in-open">
        <div class="slds-modal__container modalContainer" style="width:100%;margin:0px;padding:0px;max-width:100%;">
            <header class="slds-modal__header">
                <aura:if isTrue="{!!$Browser.isPhone}">
                    <button onclick="{!c.closeModel}" class="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse" title="{!$Label.c.Close}">
                        <lightning:icon iconName="utility:close" variant="inverse" size="small" />
                        <span class="slds-assistive-text"></span>
                    </button>
                </aura:if>
                <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!$Label.c.New_Customer_Evaluation}
                    
                </h2>
            </header>
            <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1" style="overflow: auto;">
                <aura:iteration items="{!v.formData}" var="item">
                    <div class="slds-section slds-is-open">
                        <h3 class="slds-section__title">
                            <button aria-controls="expando-unique-id" aria-expanded="true" class="slds-button slds-section__title-action">
                                <span class="slds-truncate" title="Section Title">{!item.key}</span>
                            </button>
                        </h3>
                        <div aria-hidden="false" class="slds-section__content" id="expando-unique-id">
                            <div class="demo-only demo-only--sizing slds-grid slds-wrap">
                                <aura:iteration items="{!item.value}" var="obj">
                                    <div class="slds-size_1-of-2 slds-p-around_x-small">
                                        <aura:if isTrue="{!obj.type != 'Picklist'}">
                                            <lightning:input type="{!obj.type}" aura:id="recField" value="{!obj.value}" label="{!obj.label}" required="{!obj.required}" disabled="{!obj.disabled || v.isDisabled}" name="{!obj.name}" onchange="{!c.handleChange}"></lightning:input>
                                            <aura:set attribute="else">
                                                <lightning:combobox aura:id="recField" name="{!obj.name}" label="{!obj.label}" value="{!obj.value}"  options="{! obj.column }" onchange="{! c.handleChange }" required="{!obj.required}" disabled="{!obj.disabled || v.isDisabled}"/>
                                            </aura:set>
                                        </aura:if>
                                    </div>
                                </aura:iteration>
                            </div>
                        </div>
                    </div>
                </aura:iteration>
            </div>
            <footer class="slds-modal__footer">
                <button  class="slds-button slds-button_neutral" onclick="{!c.closeModel}">{!$Label.c.Cancel}</button> 
                <aura:if isTrue="{!!v.disableForm}">
                    <lightning:button variant="brand" label="{!$Label.c.Save}" onclick="{!c.saveCE}"/> 
                </aura:if>
            </footer>
        </div>
    </section>
    <aura:if isTrue="{!v.isError}">
        <div class="slds-notify_container " >
            <div class="slds-notify slds-notify_toast slds-theme_error" role="status">
                <lightning:icon variant="inverse" iconName="utility:error" size="small" class="slds-m-right_small slds-no-flex slds-align-top"/>
                <div class="slds-notify__content">
                    <h2 class="slds-text-heading_small">{!v.errorMessage}</h2>
                </div>
                <div class="slds-notify__close">
                    <button class="slds-button slds-button_icon slds-button_icon-inverse" title="Close" onclick="{!c.hideToast}"> 
                        <lightning:icon iconName="utility:close" size="small" variant="inverse" />
                        <span class="slds-assistive-text">{!$Label.c.Close}</span> 
                    </button>
                </div>
            </div>
        </div>
    </aura:if>
</aura:component>