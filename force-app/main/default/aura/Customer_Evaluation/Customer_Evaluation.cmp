                                </div>
                                
                                <div class="slds-col slds-large-size_1-of-2 slds-size_1-of-1">	
                                    <lightning:textarea disabled="{!v.disableForm}" aura:id="recField" value="{!v.custEvaluation.The_reasons_why_you_chose_our_Company__c}" label="{!$Label.c.The_reasons_why_you_chose_our_Company}" /> 
                                </div>
                                
                                <div class="slds-col slds-large-size_1-of-2 slds-size_1-of-1">	
