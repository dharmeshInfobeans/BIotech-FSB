<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Lead_Stage__c</field>
        <field>Product__c</field>
        <field>Billing_City__c</field>
        <field>Billing_Street__c</field>
        <field>Billing_state__c</field>
        <field>Country__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Lead  Commercialized Approval</label>
        <name>Lead_Commercialized_Approval</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Lead_Commercialized_template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Lead__c.Lead_Stage__c</field>
            <operation>equals</operation>
            <value>Commercialization</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>manager_Approved_field_updates</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>update_Field_if_Approvedss</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>update_Field_if_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approval_status_field_update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Send_For_Approve_request</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Lead  Commercialized Approval Process</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
