            </action>
            <action>
                <name>update_Status</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>RSM__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Scheme_Request__c.RSM__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Scheme_Request__c.ZSM__c</field>
                <operation>equals</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Scheme_Request__c.NSM__c</field>
                <operation>equals</operation>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>RSM Approval request</label>
        <name>RSM_Approval_request</name>
        <rejectionActions>
            <action>
                <name>update_fields_rsm</name>
