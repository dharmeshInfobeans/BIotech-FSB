    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Country__c</field>
        <field>Credit_Note__c</field>
        <field>Credit_Percentage__c</field>
        <field>Pay_Terms__c</field>
        <field>PUR_Unit_Comm__c</field>
        <field>Scheme_Number__c</field>
        <field>Customer_SAP_code__c</field>
