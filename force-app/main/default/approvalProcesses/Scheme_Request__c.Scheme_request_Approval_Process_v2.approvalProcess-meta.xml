            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>ZSM_Approved_status</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>ZSM_Approveds</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>ZSM__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Scheme_Request__c.RSM__c</field>
                <operation>equals</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Scheme_Request__c.ZSM__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Scheme_Request__c.NSM__c</field>
                <operation>equals</operation>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>ZSM Approval request</label>
        <name>ZSM_Approval_request</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>update_reject_field</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>update_statsu</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>NSM__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Scheme_Request__c.NSM__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Scheme_Request__c.RSM__c</field>
                <operation>equals</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Scheme_Request__c.ZSM__c</field>
                <operation>equals</operation>
            </criteriaItems>
        </entryCriteria>
        <label>GM NSM Approval request</label>
        <name>GM_NSM_Approval_request</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Scheme_Request__c.Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>Approved,Pending</value>
        </criteriaItems>
        <criteriaItems>
            <field>Scheme_Request__c.Scheme_applied_By_Parent__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Approval_statsu</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
