<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Phakic_Rating__c</field>
        <field>Ce_Cis_Rating__c</field>
        <field>EDOF_Family__c</field>
        <field>Hydrophilics__c</field>
        <field>Hydrophobic_Monofocal__c</field>
        <field>Leads__c</field>
        <field>Account__c</field>
        <field>MF_Family__c</field>
        <field>Month__c</field>
        <field>No_of_LVC_Procedures__c</field>
        <field>Phakic__c</field>
        <field>Popular_Hydrophobic_Monofocal_Dropdown__c</field>
        <field>TORIC__c</field>
        <field>Status__c</field>
        <field>Trifocal_Family__c</field>
        <field>Year__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>User__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval Process first step</label>
        <name>Approval_Process_first_step</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>CIS_Header__c.Status__c</field>
            <operation>notEqual</operation>
            <value>Approved</value>
        </criteriaItems>
        <criteriaItems>
            <field>CIS_Header__c.Account_Record_Type__c</field>
            <operation>notEqual</operation>
            <value>International - Ortho</value>
        </criteriaItems>
        <criteriaItems>
            <field>CIS_Header__c.Account_Record_Type__c</field>
            <operation>notEqual</operation>
            <value>International -Dermal</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_the_status_field</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_Rejection</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Is_Locked</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>CE-CIS Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
