<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Status__c</field>
        <field>Sub_Status__c</field>
        <field>Temprary_Id__c</field>
        <field>region__c</field>
        <field>Country_Key__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Approver_1__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND( OR( 
RecordType.DeveloperName==&apos;Columbia_Distributor&apos;,
RecordType.DeveloperName==&apos;Columbia_Doctor&apos;
), 
OR( ISPICKVAL(Sub_Status__c, &apos;Rejected By Approver 1&apos;), 
ISPICKVAL(Sub_Status__c, &apos;Not Submitted&apos;) 
), 
NOT(ISNULL(Approver_1__c)), 
ISPICKVAL(Status__c, &apos;Draft&apos;)  
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Send_Email_Alert_To_Approver2_Colombia</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Update_Account_Sub_Status_for_Approver2</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Set_Sub_Status_Field_To_Rejected_By_Ap1</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approver_1_Colombia</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Set_Sub_Status_Field_To_Approver1</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Colmbia Process1</label>
    <processOrder>5</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
