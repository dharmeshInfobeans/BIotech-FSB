<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Status__c</field>
        <field>Sub_Status__c</field>
        <field>CE_Rating__c</field>
        <field>CIS_Rating__c</field>
        <field>Country_Key__c</field>
        <field>region__c</field>
        <field>Branch__c</field>
        <field>Account_Locked__c</field>
        <field>Account_Locked_Reason__c</field>
        <field>Temprary_Id__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Approver_1__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approver 1</label>
        <name>Approver_1</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Approver1_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND( OR( RecordType.DeveloperName == &apos;Distributor&apos;, 
RecordType.DeveloperName == &apos;Doctor_D&apos; 
), 
OR( ISPICKVAL(Sub_Status__c, &apos;Rejected By Approver 1&apos;), 
ISPICKVAL(Sub_Status__c, &apos;Not Submitted&apos;) 
), 
NOT(ISNULL(Approver_1__c)), 
ISPICKVAL(Status__c, &apos;Draft&apos;), 
No_Of_CE_Records__c &gt;= 1 
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Send_Approval_To_Branch_Email_Address_Location_Wise</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Set_Sub_Status_Field_To_Branch</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected_By_Approver1</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Send_Approval_Email_To_Approver_1</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Set_Sub_Status_Field_To_Approver1</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Approver1 Process</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
