<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Event_type_Name__c</field>
        <field>Description__c</field>
        <field>Beat_Date__c</field>
        <field>Assigned_To__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Out of office Approval</label>
        <name>Out_of_office_Approval</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Out_of_Office_Approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Beat_Plan__c.Event_type_Name__c</field>
            <operation>contains</operation>
            <value>Out of office</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_status_field_update_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>final_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Send_Approved_Email_Alert</name>
            <type>Alert</type>
        </action>
        <action>
            <name>update_Field_if_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_no_reporting_field</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Approval_status_field_update_Reject</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>final_Approved_false</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Out_of_office_rejection_true</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Send_reject_Email_Alert</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approval_status_field_update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Send_for_Approval_request</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Out of office Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
