<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Status__c</field>
        <field>Sub_Status__c</field>
        <field>Temprary_Id__c</field>
        <field>region__c</field>
        <field>Country_Key__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>aysegulekus@biotechhealthcare.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND( OR( RecordType.DeveloperName == &apos;Distributor_T&apos;, 
          RecordType.DeveloperName == &apos;Doctor_T&apos; 
       ), 
      OR( ISPICKVAL(Sub_Status__c, &apos;Not Submitted&apos;), 
          ISPICKVAL(Sub_Status__c, &apos;Rejected By Approver 1&apos;) 
      ), 
      NOT(ISNULL(Approver_1__c)), 
      ISPICKVAL(Status__c, &apos;Draft&apos;)  
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Send_Email_Alert_To_Approver2_Turkey</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Update_Account_Sub_Status_for_Approver2</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Set_Sub_Status_Field_To_Rejected_By_Ap1</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Set_Sub_Status_Field_To_Approver1</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Approver1 Process Turkey</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
