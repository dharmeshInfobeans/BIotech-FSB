<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Beat_Date__c</field>
        <field>Event_type_Name__c</field>
        <field>Assigned_To__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Leave Approval request</label>
        <name>Leave_Approval_request</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Beat_Plan__c.Event_type_Name__c</field>
            <operation>contains</operation>
            <value>Leave</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>final_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Send_For_Approve_request</name>
            <type>Alert</type>
        </action>
        <action>
            <name>update_Field_if_Approveds</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Approvasl_status_field_update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>final_Approved_false</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Leave_rejetion_true</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Send_Leave_request_Approval_email_alert</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Send_Leave_request_Approval</name>
            <type>Alert</type>
        </action>
        <action>
            <name>update_Approval_status</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Rejcted_Field</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Leave Approval Process</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
