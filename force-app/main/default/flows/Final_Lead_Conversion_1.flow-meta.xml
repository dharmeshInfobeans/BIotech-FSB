    <formulas>
        <name>dynamicAccountId</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Lead.Existing_customer__c} , {!Get_Lead.Account__c} ,
IF(NOT(ISBLANK({!Create_Account_Recocrd})),{!Create_Account_Recocrd.Id}, {!Get_Account.Id})



)</expression>
    </formulas>
    <formulas>
        <name>dynamicContactId</name>
        <dataType>String</dataType>
        <expression>IF({!Create_Contacttt}=&apos;Create new Contact&apos;,{!Create_Contact_Record.Id},{!Contact.selectedChoiceValues})</expression>
    </formulas>
    <formulas>
        <name>OpportunityName</name>
        <dataType>String</dataType>
        <expression>LEFT(
  IF(
    {!Get_Lead.Existing_customer__c},
    {!Get_Account.Name},
    {!Get_Lead.Company__c}
  ),
  80
)</expression>
    </formulas>
    <formulas>
        <name>varFinalContactId</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!Select_Contact_2.selectedChoiceValues})),
    {!Select_Contact_2.selectedChoiceValues},
    IF(
        NOT(ISBLANK({!varCreatedContactId})),
        {!varCreatedContactId},
        IF(
            NOT(ISBLANK({!Get_Contact.Id})),
            {!Get_Contact.Id},
            {!dynamicContactId}
        )
    )
)</expression>
    </formulas>
