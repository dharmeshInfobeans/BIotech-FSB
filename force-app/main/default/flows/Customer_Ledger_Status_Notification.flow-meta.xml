            </connector>
            <label>Ledger Status Is Changed</label>
        </rules>
        <rules>
            <name>A_record_is_Signed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Signed_Document_Processed__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Signed_Ledger_to_Finance</targetReference>
            </connector>
            <label>A record is Signed</label>
        </rules>
    </decisions>
