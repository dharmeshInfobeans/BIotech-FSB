    <formulas>
        <name>AgreementVersionIncreased</name>
        <dataType>String</dataType>
        <expression>LEFT(TEXT({!Get_Original_Master_Agreement_Record.version__c}), 1) &amp; 
TEXT(VALUE(MID(TEXT({!Get_Original_Master_Agreement_Record.version__c}), 2, LEN(TEXT({!Get_Original_Master_Agreement_Record.version__c})))) + 1)</expression>
    </formulas>
    <formulas>
        <name>DateofAmendment</name>
        <dataType>String</dataType>
        <expression>TEXT(DAY( {!$Flow.CurrentDate} )) &amp;
CASE(
DAY( {!$Flow.CurrentDate} ),
1, &apos;st&apos;,
2, &apos;nd&apos;,
3, &apos;rd&apos;,
21, &apos;st&apos;,
22, &apos;nd&apos;,
23, &apos;rd&apos;,
31, &apos;st&apos;,
&apos;th&apos;
)
&amp; &quot; &quot; &amp;
CASE(
MONTH( {!$Flow.CurrentDate} ),
1, &quot;January&quot;,
2, &quot;February&quot;,
3, &quot;March&quot;,
4, &quot;April&quot;,
5, &quot;May&quot;,
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;August&quot;,
9, &quot;September&quot;,
10, &quot;October&quot;,
11, &quot;November&quot;,
12, &quot;December&quot;,
&quot;Invalid Month&quot;
)
&amp; &quot;, &quot; &amp;
TEXT(YEAR( {!$Flow.CurrentDate} ))</expression>
    </formulas>
