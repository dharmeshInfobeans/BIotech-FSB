    <decisions>
        <name>Check_for_Record_Type</name>
        <label>Check for Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Product</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Currency_Conversion_Rate</targetReference>
            </connector>
            <label>if Product</label>
        </rules>
    </decisions>
    <decisions>
        <name>Current_Currency_OR_USD</name>
        <label>Current Currency OR USD</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Other_Currency_Rate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>USD</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Itrate_Each_Currency.IsoCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>USD</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_USD_Rate</targetReference>
            </connector>
            <label>USD</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>INRValue</name>
        <dataType>Number</dataType>
        <expression>VALUE(TEXT({!$Record.Total_PF_ASP__c} / {!OtherCurrencyRate}))</expression>
        <scale>10</scale>
    </formulas>
    <formulas>
        <name>INRValue_Total_Product_ASP</name>
        <dataType>Number</dataType>
        <expression>VALUE(TEXT({!$Record.Total_Product_ASP__c} / {!OtherCurrencyRate}))</expression>
        <scale>10</scale>
    </formulas>
    <formulas>
        <name>INRValue_Total_Product_MSP</name>
        <dataType>Number</dataType>
        <expression>VALUE(TEXT({!$Record.Total_Product_MSP__c} / {!OtherCurrencyRate}))</expression>
        <scale>10</scale>
    </formulas>
    <formulas>
        <name>USDConversion</name>
        <dataType>Number</dataType>
        <expression>{!INRValue} * {!USDRate}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>USDConversion_Total_Product_ASP</name>
        <dataType>Number</dataType>
        <expression>{!INRValue_Total_Product_ASP}* {!USDRate}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>USDConversion_Total_Product_MSP</name>
        <dataType>Number</dataType>
        <expression>{!INRValue_Total_Product_MSP}* {!USDRate}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Currency Conversion In USD {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Currency Conversion In USD v2</label>
