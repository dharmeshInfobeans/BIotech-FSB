  IF(AND(NOT(ISBLANK({!$Record.Xtense_Tool__c})), {!$Record.Xtense_Tool__c} &lt;&gt; &quot;0&quot;), &quot;Xtense Tool&quot;,
  IF(AND(NOT(ISBLANK({!$Record.Trio_Plus_Tool__c})), {!$Record.Trio_Plus_Tool__c} &lt;&gt; &quot;0&quot;), &quot;Trio Plus Tool&quot;,
  &quot;&quot;))))))))))
