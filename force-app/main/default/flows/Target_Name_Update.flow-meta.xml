  IF(AND(NOT(ISBLANK({!$Record.Testimonials__c})), {!$Record.Testimonials__c} &lt;&gt; &quot;0&quot;), &quot;Testimonials&quot;,
  IF(AND(NOT(ISBLANK({!$Record.Phakic_Welcome_Kit__c})), {!$Record.Phakic_Welcome_Kit__c} &lt;&gt; &quot;0&quot;), &quot;Phakic Welcome Kit&quot;,
