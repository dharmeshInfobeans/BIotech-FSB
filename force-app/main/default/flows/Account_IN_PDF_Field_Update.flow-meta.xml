    <decisions>
        <name>check_if_account_owner_main_division_is_COH_or_not</name>
        <label>check if account owner main division is COH or not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IS_COH</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.Main_Division__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>COH</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Values</targetReference>
            </connector>
            <label>IS COH</label>
        </rules>
        <rules>
            <name>NOT_COH</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.Main_Division__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>COH</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_non_COH_values</targetReference>
            </connector>
            <label>NOT COH</label>
        </rules>
    </decisions>
