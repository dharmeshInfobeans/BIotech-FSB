    <customErrors>
        <name>Evaluation_Stage_cant_be_marked</name>
        <label>Evaluation Stage cant be marked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Evaluation Stage Can&apos;t be marked until a sample request is created.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Stage_Cannout_be_updated_without_product</name>
        <label>Stage Cannout be updated without product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Stage update requires at least one product to be added to the opportunity. Kindly add a product before updating the Stage.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>CheckStage</name>
        <label>CheckStage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_CheckStage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sample_Requested__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Stage_Text_c_and_Date_c</targetReference>
            </connector>
            <label>Outcome 1 of CheckStage</label>
        </rules>
        <rules>
            <name>Is_sample_request_before_evaluation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sample_Requested__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Evaluation_Stage_cant_be_marked</targetReference>
            </connector>
            <label>Is sample request before evaluation</label>
        </rules>
        <rules>
            <name>Stage_is_Evaluation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_opp</targetReference>
            </connector>
            <label>Stage is Evaluation</label>
        </rules>
    </decisions>
    <decisions>
        <name>No_Stage_Update_Without_Product</name>
        <label>No Stage Update Without Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CheckStage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Product_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Total_PF_ASP__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_Cannout_be_updated_without_product</targetReference>
            </connector>
            <label>No Product Available</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>OPPNAME</name>
        <dataType>String</dataType>
        <expression>LEFT(
IF({!$Record.RecordType.Name} = &apos;Product&apos; , 
{!$Record.Account__r.Name} &amp; &quot;-&quot; &amp;{!$Record.Contact__r.FirstName}&amp;&quot; &quot;&amp;{!$Record.Contact__r.LastName}&amp;&quot;-&quot; &amp; TEXT({!$Record.Product_Family__c}) ,
{!$Record.Account__r.Name} &amp; &quot;-&quot; &amp; IF(TEXT({!$Record.Equipment_Opportunity_Type__c}) = &apos;Solo Equipment Sale&apos;,
LEFT(TEXT({!$Record.Equipment_Opportunity_Type__c}),4) &amp; &quot;- EQ&quot;  ,
LEFT(TEXT({!$Record.Equipment_Opportunity_Type__c}),6) &amp; &quot;- EQ&quot;
)
),
80
)</expression>
    </formulas>
    <interviewLabel>Opportunity : Store Stage and Date value {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity : Store Stage and Date value</label>
