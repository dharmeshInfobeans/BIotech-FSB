    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CheckCompletedNow</name>
        <label>Just Marked Completed?</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>No - Exit</defaultConnectorLabel>
        <rules>
            <name>Yes_JustCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetMeeting</targetReference>
            </connector>
            <label>Yes - Just Completed</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckMOMRecord</name>
        <label>Has MOM Meeting?</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No - Exit</defaultConnectorLabel>
        <rules>
            <name>Yes_HasMeeting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Meeting__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CheckCompletedNow</targetReference>
            </connector>
            <label>Yes - Has Meeting</label>
        </rules>
    </decisions>
    <description>Sends in-app notification to Meeting Owner and emails to Attendees and Distributor when an Action Item is marked Completed</description>
    <environments>Default</environments>
    <formulas>
        <name>frmCompletionWeek</name>
        <dataType>Number</dataType>
        <expression>CEILING((TODAY() - DATE(YEAR(TODAY()), 1, 1) + 1) / 7)</expression>
        <scale>0</scale>
    </formulas>
