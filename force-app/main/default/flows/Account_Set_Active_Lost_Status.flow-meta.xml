    <environments>Default</environments>
    <formulas>
        <name>AccountReactivated</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISPICKVAL({!loop_through_accounts.Account_Status__c}, &quot;Inactive&quot;),
    NOT(ISBLANK({!Get_Opp.Id})),
    ISPICKVAL({!Get_Opp.Status__c}, &quot;Closed Won&quot;),
    TODAY() - DATEVALUE({!Get_Opp.CreatedDate}) &lt; 365
)</expression>
    </formulas>
    <formulas>
        <name>AccountReactivated2min</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISPICKVAL({!loop_through_accounts.Account_Status__c}, &quot;Inactive&quot;),
    NOT(ISBLANK({!Get_Opp.Id})),
    ISPICKVAL({!Get_Opp.Status__c}, &quot;Closed Won&quot;),
    (NOW() - {!Get_Opp.CreatedDate}) * 1440 &gt;= 2
)</expression>
    </formulas>
    <formulas>
        <name>Dormantstatus</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISPICKVAL({!loop_through_accounts.Account_Status__c}, &quot;Active&quot;),
    NOT(ISBLANK({!loop_through_accounts.SAP_Code__c})),
    NOT(ISBLANK({!Get_Opp.Id})),
    NOT(ISPICKVAL({!Get_Opp.Status__c}, &quot;Closed Won&quot;))
)</expression>
    </formulas>
    <formulas>
        <name>IsAccountInactive365</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        ISBLANK({!Get_Opp.Id}),
        TODAY() - DATEVALUE({!loop_through_accounts.CreatedDate}) &gt;= 365
    ),
    AND(
        NOT(ISPICKVAL({!Get_Opp.Status__c}, &quot;Closed Won&quot;)),
        TODAY() - DATEVALUE({!Get_Opp.CreatedDate}) &gt;= 365
    )
)</expression>
    </formulas>
    <formulas>
        <name>olderthan2min</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        ISBLANK({!Get_Opp.Id}),
        (NOW() - {!loop_through_accounts.CreatedDate}) * 1440 &gt;= 2
    ),
    AND(
        NOT(ISPICKVAL({!Get_Opp.Status__c}, &quot;Closed Won&quot;)),
        (NOW() - {!Get_Opp.CreatedDate}) * 1440 &gt;= 2
    )
)</expression>
    </formulas>
