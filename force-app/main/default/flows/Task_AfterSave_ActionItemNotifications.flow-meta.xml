    <decisions>
        <name>CheckAssignmentTrigger</name>
        <label>Assignment Notification Needed?</label>
        <locationX>578</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>CheckTargetWeekTrigger</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Assignment</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendAssignmentCustomNotif</targetReference>
            </connector>
            <label>Yes - New or Owner Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckMOMRecordType</name>
        <label>Is MOM Action Item?</label>
        <locationX>930</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No Meeting - Exit</defaultConnectorLabel>
        <rules>
            <name>Yes_IsMOMActionItem</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Meeting__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetMeeting</targetReference>
            </connector>
            <label>Yes - MOM Action Item</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckTargetWeekTrigger</name>
