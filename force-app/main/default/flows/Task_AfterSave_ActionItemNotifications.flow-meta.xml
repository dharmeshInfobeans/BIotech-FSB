        <locationX>578</locationX>
        <locationY>1211</locationY>
        <defaultConnectorLabel>No - Exit</defaultConnectorLabel>
        <rules>
            <name>Yes_TargetWeek</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ActivityDate</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.ActivityDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendAttendeeDueDateEmails</targetReference>
            </connector>
            <label>Yes - Due Date Changed</label>
        </rules>
    </decisions>
