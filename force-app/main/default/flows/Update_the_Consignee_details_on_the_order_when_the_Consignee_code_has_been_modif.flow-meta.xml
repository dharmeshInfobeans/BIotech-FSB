    <decisions>
        <name>Check_Consignee_Code_Values</name>
        <label>Check Consignee Code Values</label>
        <locationX>182</locationX>
        <locationY>695</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Consignee_Code_Prior_value_has_not_been_null_and_it_s_updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Consignee_Code__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Consignee_Code__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Consignee_Code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Consignee_Code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_record_which_have_same_SAP_code_as_Consignee_code</targetReference>
            </connector>
            <label>Consignee Code Prior value has not been null and it&apos;s updated</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_if_Vertical_has_been_update</name>
