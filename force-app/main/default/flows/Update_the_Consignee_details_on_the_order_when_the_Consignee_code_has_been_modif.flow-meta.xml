                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_active_master_agreement</targetReference>
            </connector>
            <label>is updated</label>
        </rules>
    </decisions>
